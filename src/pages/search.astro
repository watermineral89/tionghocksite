---
import PageLayout from "../layouts/PageLayout.astro";

const seoTitle = "Stock Search | Tiong Hock Auto Parts Kuching & Samarahan";
const seoDescription =
	"Search Tiong Hock Auto Parts catalog for genuine and OEM spare parts in Kuching and Kota Samarahan. Check availability (In stock, Limited, Enquire) — WhatsApp for price and fitment.";
---

<PageLayout title={seoTitle} description={seoDescription}>
	<section class="th-section-alt">
		<div class="th-container">
			<div class="max-w-2xl" data-animate="fade-up">
				<p class="th-tech-badge">Parts lookup</p>
				<h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
					Search Our Stock
				</h1>
				<p class="mt-4 text-base leading-relaxed text-slate-600">
					Find parts by SKU, description, or brand. Availability is shown as <strong>In stock</strong>,
					<strong>Limited</strong>, or <strong>Enquire</strong> — pricing and exact quantities are shared via WhatsApp only.
				</p>
			</div>

			<div class="mt-10 max-w-3xl" data-stock-search-root data-animate="fade-up">
				<form data-stock-search-form class="flex flex-col gap-3 sm:flex-row" role="search" aria-label="Stock search">
					<label class="sr-only" for="stock-search-input">Search parts</label>
					<input
						id="stock-search-input"
						data-stock-search-input
						type="search"
						name="q"
						autocomplete="off"
						spellcheck="false"
						placeholder="e.g. brake pad, KYB, APM R134a, ALT-12V…"
						class="min-h-12 flex-1 rounded-xl border border-slate-200 bg-white px-4 text-base text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-brand-green focus:ring-2 focus:ring-brand-green/20"
					/>
					<button
						type="submit"
						class="min-h-12 rounded-xl bg-brand-green px-6 text-sm font-semibold text-white transition hover:bg-[color-mix(in_oklab,var(--color-brand-green)_88%,black)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
					>
						Search
					</button>
				</form>

				<p data-stock-search-status class="mt-3 font-mono text-xs text-slate-500" hidden aria-live="polite">
					Searching…
				</p>
				<p data-stock-search-meta class="mt-4 text-sm text-slate-500">
					Type at least 2 characters to search our catalog.
				</p>

				<div data-stock-search-results class="mt-6 flex flex-col gap-3" aria-live="polite"></div>
			</div>

			<div class="mt-12 rounded-xl border border-slate-200 bg-white p-5 text-sm leading-relaxed text-slate-600 shadow-sm sm:p-6">
				<h2 class="text-base font-semibold text-slate-900">How availability works</h2>
				<ul class="mt-3 grid gap-2 sm:grid-cols-3">
					<li><span class="th-avail th-avail-in">In stock</span> — readily available (3+ units)</li>
					<li><span class="th-avail th-avail-limited">Limited</span> — low stock (1–2 units)</li>
					<li><span class="th-avail th-avail-enquire">Enquire</span> — confirm via WhatsApp</li>
				</ul>
				<p class="mt-4 text-slate-500">
					Prices, costs, and exact quantities are never shown online. For fitment checks, message us on WhatsApp with your vehicle or chassis number.
				</p>
			</div>
		</div>
	</section>
</PageLayout>

<script>
	import { initStockSearch } from "../scripts/stock-search";

	document.querySelectorAll<HTMLElement>("[data-stock-search-root]").forEach((root) => initStockSearch(root));
</script>
