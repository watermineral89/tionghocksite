---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/Hero.astro";
import HomeQuickLinks from "../components/HomeQuickLinks.astro";
import OrganizationStructuredData from "../components/OrganizationStructuredData.astro";
import { HERO_CAR_IMAGE, heroFeatureAvifSrcset } from "../constants/hero-lcp";

const whatsappHref = `https://wa.me/60168860864?text=${encodeURIComponent("Hello Tiong Hock — I have a parts inquiry.\n\nVehicle / chassis no.: \nParts needed: ")}`;
const heroLcpAvifSrcset = heroFeatureAvifSrcset(HERO_CAR_IMAGE.base, HERO_CAR_IMAGE.widths);
---
<PageLayout
	title="Tiong Hock | Automotive Spare Parts Kuching"
	description="Tiong Hock supplies genuine and OEM automotive spare parts for workshops, fleets and drivers in Kuching. 50,000+ active line items from Matang Jaya and Kota Samarahan."
>
	<Fragment slot="head">
		<link
			rel="preload"
			as="image"
			type="image/avif"
			href={HERO_CAR_IMAGE.preloadHref}
			imagesrcset={heroLcpAvifSrcset}
			imagesizes={HERO_CAR_IMAGE.sizes}
			fetchpriority="high"
		/>
	</Fragment>
 <Hero
		eyebrow="KEEPING YOU ON THE ROAD"
		titleLead="The right parts."
		titleAccent="Ready for the road."
		location="Matang Jaya · Kota Samarahan"
		whatsappHref={whatsappHref}
	/>
 <HomeQuickLinks />
 <Fragment slot="body-end">
	<OrganizationStructuredData />
 </Fragment>
</PageLayout>
