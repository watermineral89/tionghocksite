---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";


interface Props {
	title?: string;
	description?: string;
	includeCanonical?: boolean;
	robots?: string;
}

const { title, description, includeCanonical, robots } = Astro.props;
---

<BaseLayout title={title} description={description} includeCanonical={includeCanonical} robots={robots}>
	<slot name="head" slot="head" />
	<slot name="body-end" slot="body-end" />
	<a class="skip-link" href="#main-content">Skip to content</a><Navbar />
	<main id="main-content" class="overflow-x-clip" tabindex="-1">
		<slot />
	</main>
	<Footer />
	
</BaseLayout>

<script>
	const motionSelector =
		"[data-animate='fade-up'], [data-animate='stagger-parent'], [data-parallax]";
	if (document.querySelector(motionSelector)) {
		void import("../scripts/gsap-init").then(({ initScrollAnimations }) => initScrollAnimations());
	}
</script>

