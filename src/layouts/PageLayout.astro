---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";


interface Props {
	title?: string;
	description?: string;
	includeCanonical?: boolean;
	robots?: string;
}

const { title, description, includeCanonical, robots } = Astro.props;
---

<BaseLayout title={title} description={description} includeCanonical={includeCanonical} robots={robots}>
	<slot name="head" slot="head" />
	<a class="skip-link" href="#main-content">Skip to content</a><Navbar />
	<main id="main-content" class="overflow-x-clip" tabindex="-1">
		<slot />
	</main>
	<Footer />
	
</BaseLayout>

<script>
	import { initScrollAnimations } from "../scripts/gsap-init";
	initScrollAnimations();
</script>

