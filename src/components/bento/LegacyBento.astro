---
import BentoCard from "../ui/BentoCard.astro";

const valueProps = [
	{
		title: "Inventory Depth",
		body: "With 50,000+ active line items in stock, we minimize downtime for retail customers and commercial fleets alike.",
		icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
	},
	{
		title: "Specialist Knowledge",
		body: "Our team of 40 dedicated staff brings decades of combined expertise in parts identification, fitment accuracy, and technical support.",
		icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
	},
	{
		title: "Genuine Quality",
		body: "We prioritize genuine and high-performance aftermarket components, ensuring every part that leaves our warehouse meets OEM standards.",
		icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
	},
	{
		title: "Local Logistics, Global Standards",
		body: "Operating from our strategic hub in Matang Jaya, we provide efficient fulfillment for the East Malaysian market, combining deep local roots with professional enterprise management.",
		icon: "M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17H4a1 1 0 01-1-1v-2a1 1 0 011-1h11",
	},
];

const stats = [
	{
		title: "Ready stock",
		body: "HQ in Matang Jaya plus Automart at Uni Central, Kota Samarahan—maximum availability and faster pickup across outlets.",
	},
	{
		title: "Proven track record",
		body: "Four decades supporting workshops with consistent identification, fair pricing, and dependable supply.",
	},
	{
		title: "Deep inventory",
		body: "Broad SKU coverage across fast-moving lines so you spend less time chasing stock across suppliers.",
	},
	{
		title: "Same-day fulfilment",
		body: "Cut-off windows on core movers aligned to workshop schedules—pick up or arrange dispatch the same day when available.",
	},
];
---

<section id="about" class="scroll-mt-24 th-section-alt" aria-labelledby="about-legacy-heading">
	<div class="th-container">
		<div
			class="grid auto-rows-[minmax(160px,auto)] grid-cols-1 gap-4 lg:grid-cols-6"
			data-animate="stagger-parent"
		>
			<BentoCard span="lg:col-span-4 lg:row-span-2" accent badges={["EST. KCH", "MSIC 45300"]} class="!p-6 sm:!p-8">
				<p class="th-tech-badge">About Tiong Hock Auto Parts (KCH) Sdn Bhd</p>
				<h2
					id="about-legacy-heading"
					class="mt-6 text-3xl font-bold tracking-[0.14em] text-slate-900 sm:text-4xl lg:text-5xl"
				>
					OUR LEGACY
				</h2>
				<p class="mt-6 text-xl font-semibold leading-snug tracking-tight text-slate-800 sm:text-2xl">
					The Backbone of Kuching&rsquo;s Automotive Industry
				</p>
				<p class="mt-6 text-justify text-base leading-relaxed text-slate-600 sm:text-lg">
					Since our inception, Tiong Hock Auto Parts (KCH) Sdn Bhd has been the dependable link between global
					manufacturers and Kuching&rsquo;s workshops. From Matang Jaya and our expanding branch network, we keep more
					than 50,000 active line items ready—so you can get the right part quickly, at a fair price, with fitment checked
					properly.
				</p>
				<p
					class="mt-5 border-l-2 border-brand-green pl-5 text-justify text-base font-medium leading-relaxed text-slate-800 sm:text-lg"
				>
					We have evolved beyond just being a store. We understand that a broken-down car isn't just a mechanical
					issue—it's a disruption to your life and your livelihood. By combining <strong class="font-semibold text-slate-900">StockPilot</strong> — our own in-house developed inventory system — with an honest, engineering-first approach, we ensure you get the right part at a fair price, every time.
				</p>
			</BentoCard>

			{
				valueProps.map((item) => (
					<BentoCard span="lg:col-span-2">
						<svg class="h-9 w-9 shrink-0 text-brand-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={item.icon} />
						</svg>
						<h3 class="mt-4 text-sm font-bold uppercase tracking-wide text-brand-green">{item.title}</h3>
						<p class="mt-2 flex-1 text-justify text-sm leading-relaxed text-slate-600">{item.body}</p>
					</BentoCard>
				))
			}

			<BentoCard span="lg:col-span-6" badges={["CORE BUSINESS"]}>
				<h3 id="about-core-business-heading" class="text-xs font-bold uppercase tracking-[0.22em] text-brand-green">
					Our Core Business
				</h3>
				<p class="mt-4 max-w-4xl text-justify text-base leading-relaxed text-slate-600 sm:text-lg">
					Classified under MSIC 45300, Tiong Hock specializes in the high-volume wholesale and retail distribution of
					automotive components, specialized tools, and technical supplies. From local workshops to large-scale
					commercial fleet management, we provide the engineering certainty and inventory depth required to minimize
					downtime and maximize vehicle performance.
				</p>
				<div class="mt-8 border-t border-slate-200 pt-8">
					<p class="text-lg font-bold uppercase tracking-[0.08em] text-slate-900 sm:text-xl">
						TIONG HOCK AUTO PARTS (KCH) SDN BHD
					</p>
					<p class="mt-3 text-base font-semibold text-brand-green sm:text-lg">Trading of Spare Parts and Accessories.</p>
				</div>
			</BentoCard>

			<div class="lg:col-span-6">
				<p class="th-tech-badge">Matang &amp; Samarahan · Sarawak</p>
				<h3 class="mt-4 text-xl font-bold uppercase tracking-[0.14em] text-slate-900 sm:text-2xl">Reliable &amp; affordable</h3>
			</div>

			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-6 lg:grid-cols-4">
				{
					stats.map((stat) => (
						<BentoCard>
							<h4 class="text-sm font-bold uppercase tracking-[0.12em] text-brand-green">{stat.title}</h4>
							<p class="mt-3 flex-1 text-justify text-sm leading-relaxed text-slate-600">{stat.body}</p>
						</BentoCard>
					))
				}
			</div>
		</div>
	</div>
</section>
