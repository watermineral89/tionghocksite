---
import SectionHeader from "../ui/SectionHeader.astro";

const leaders = [
	{
		name: "Gary Chan Kee Chong",
		initials: "GC",
		role: "Director of Operations & Logistics",
		badge: "OPS · LOG",
		photo: "/DIRECTOR GARY.jpg",
		qualification: "10+ years aerospace operations & logistics",
		quote:
			"Coming from aerospace, I don't do 'close enough.' A warehouse this size only works if every location and every count is exactly where it's supposed to be.",
		vision: "Aerospace-grade precision applied to every line of automotive inventory we move.",
		strength: "Core infrastructure, warehouse discipline, and logistics that scale without breaking.",
		detail:
			"The senior director overseeing the company's core infrastructure. Integrates aerospace-grade precision into large-scale automotive parts distribution.",
	},
	{
		name: "Rahim Chan",
		initials: "RC",
		role: "Managing Director & Chief Visionary",
		badge: "MD · VISION",
		photo: "/DIRECTOR RAHIM.jpg",
		qualification: "B.Eng (Hons) Civil Engineering — University of Nottingham",
		quote:
			"Every branch we open has to make the next one easier, not harder. That's the only kind of growth worth chasing.",
		vision: "Engineering logic driving multi-branch growth and long-term industry leadership.",
		strength: "Strategic expansion, procurement foresight, and the blueprint for Tiong Hock's next chapter.",
		detail:
			"The lead architect of Tiong Hock's expansion. He combines engineering logic with the foresight to drive our multi-branch growth and long-term industry strategy.",
	},
	{
		name: "Vince Chan Chee Hou",
		initials: "VC",
		role: "Technical Director & Systems Architect",
		badge: "TECH · STOCKPILOT",
		photo: "/DIRECTOR VINCE.jpg",
		qualification: "B.Eng (Hons) Civil Engineering — Curtin University",
		quote:
			"I built StockPilot because I was tired of guessing where stock actually was. Now the whole team can see it — and so can I.",
		vision: "Digitizing the warehouse so fitment, stock, and fulfilment run on engineering certainty.",
		strength: "StockPilot — our own in-house developed system powering inventory, picking, and fulfilment across every branch.",
		detail:
			"Lead architect and developer of StockPilot, Tiong Hock's internally built inventory and warehouse management platform.",
	},
	{
		name: "Ivan Yong",
		initials: "IY",
		role: "Director of Sales & Mechanical Engineering",
		badge: "SALES · MECH",
		photo: "/DIRECTOR IVAN.jpg",
		qualification: "B.Eng (1st Class Hons) Mechanical Engineering — UCSI University",
		quote:
			"Half my job is figuring out why a part failed before I even talk about the replacement. Get the diagnosis right and the sale takes care of itself.",
		vision: "Workshop-grade technical support — parts identified correctly, failures understood deeply.",
		strength: "Mechanical engineering rigour on the sales floor — failure analysis and fitment you can trust.",
		detail: "Expert in failure analysis and technical workshop support.",
	},
];
---

<section
	id="technical-leadership"
	class="scroll-mt-24 th-section-alt"
	aria-labelledby="technical-leadership-heading"
>
	<div class="th-container pb-10 md:pb-14">
		<SectionHeader
			eyebrow="Core leadership"
			title="Technical leadership"
			description="Scroll to meet the team — engineering-led operations, procurement discipline, and systems-backed inventory."
			headingId="technical-leadership-heading"
			class="!items-start"
		/>
	</div>

	<div class="leadership-scroll md:hidden">
		{
			leaders.map((person, index) => (
				<article class="border-b border-slate-200/80 px-6 py-12 last:border-b-0 sm:px-10">
					<p class="th-tech-badge">{person.badge}</p>
					<div class="mt-6 overflow-hidden">
						{
							person.photo ? (
								<img
									src={person.photo}
									alt={person.name}
									width={640}
									height={800}
									class="leader-photo mx-auto max-h-[420px] w-auto max-w-full object-contain object-bottom"
									loading={index === 0 ? "eager" : "lazy"}
									decoding="async"
								/>
							) : (
								<div
									class="mx-auto flex h-56 max-w-xs items-end justify-center bg-gradient-to-t from-slate-100/80 to-transparent"
									aria-hidden="true"
								>
									<span class="translate-y-4 font-mono text-7xl font-bold tracking-wider text-slate-200">
										{person.initials}
									</span>
								</div>
							)
						}
					</div>
					<h3 class="mt-6 text-xl font-bold text-slate-900">{person.name}</h3>
					<p class="mt-1 text-xs font-semibold uppercase tracking-wide text-brand-green sm:text-sm">{person.role}</p>
					<blockquote class="leader-quote mt-5">
						<p>{person.quote}</p>
					</blockquote>
					<div class="mt-5">
						<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Qualification</p>
						<p class="mt-1.5 text-left text-sm font-medium leading-relaxed text-slate-800">{person.qualification}</p>
					</div>
					<div class="mt-6 space-y-4">
						<div>
							<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Vision</p>
							<p class="mt-1.5 text-left text-sm leading-relaxed text-slate-700">{person.vision}</p>
						</div>
						<div>
							<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Strength</p>
							<p class="mt-1.5 text-left text-sm leading-relaxed text-slate-600">{person.strength}</p>
						</div>
					</div>
					<p class="mt-6 text-left text-sm leading-relaxed text-slate-500">{person.detail}</p>
				</article>
			))
		}
	</div>

	<div
		class="leadership-scroll-track relative hidden md:block"
		data-leadership-scroll
		style={`--leader-count: ${leaders.length}`}
	>
		<div class="leadership-scroll-pin" data-leadership-pin>
			<div class="th-container">
				<div class="leadership-stage grid min-h-[72vh] grid-cols-12 items-end gap-8 lg:min-h-[78vh] lg:gap-12">
					<div class="relative col-span-5 h-[min(72vh,680px)] lg:col-span-6">
						{
							leaders.map((person, index) => (
								<div
									class="leader-photo-layer absolute inset-0 flex items-end justify-center"
									data-leader-photo
									data-leader-index={index}
									style={index === 0 ? undefined : "visibility:hidden;opacity:0"}
								>
									{
										person.photo ? (
											<img
												src={person.photo}
												alt={person.name}
												width={720}
												height={900}
												class="leader-photo mx-auto h-full max-h-[min(72vh,680px)] w-auto max-w-full object-contain object-bottom"
												loading={index === 0 ? "eager" : "lazy"}
												decoding="async"
											/>
										) : (
											<div
												class="flex h-full w-full items-end justify-center bg-gradient-to-t from-slate-100/70 via-slate-50/20 to-transparent pb-6"
												aria-hidden="true"
											>
												<span class="font-mono text-[clamp(5rem,14vw,9rem)] font-bold leading-none tracking-wider text-slate-200/90">
													{person.initials}
												</span>
											</div>
										)
									}
								</div>
							))
						}
					</div>

					<div class="relative col-span-7 self-stretch lg:col-span-6">
						<div class="relative h-[min(72vh,680px)]">
							<div
								class="pointer-events-none absolute inset-x-0 top-[11%] z-10 flex items-center justify-between gap-4 lg:top-[9%]"
								aria-hidden="true"
							>
								<div class="flex items-center gap-2">
									{
										leaders.map((_, index) => (
											<span
												class:list={[
													"leader-dot h-1.5 rounded-full bg-slate-200 transition-all duration-300",
													index === 0 && "active w-8 bg-brand-green",
													index !== 0 && "w-1.5",
												]}
												data-leader-dot
												data-leader-index={index}
											/>
										))
									}
								</div>
								<p class="font-mono text-xs tracking-[0.2em] text-slate-400">
									<span data-leader-counter>01</span>
									<span aria-hidden="true"> / </span>
									<span>{String(leaders.length).padStart(2, "0")}</span>
								</p>
							</div>

							{
								leaders.map((person, index) => (
									<article
										class="leader-panel absolute inset-x-0 top-[10%] z-20 lg:top-[8%]"
										data-leader-panel
										data-leader-index={index}
										style={index === 0 ? undefined : "visibility:hidden;opacity:0"}
									>
										<p class="th-tech-badge relative -mt-1">{person.badge}</p>
										<h3 class="mt-3 text-2xl font-bold leading-tight text-slate-900 lg:text-3xl">{person.name}</h3>
										<p class="mt-2 text-sm font-semibold uppercase tracking-wide text-brand-green">{person.role}</p>

										<blockquote class="leader-quote mt-5 max-w-2xl">
											<p>{person.quote}</p>
										</blockquote>

										<div class="mt-5 max-w-2xl">
											<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Qualification</p>
											<p class="mt-2 text-left text-sm font-medium leading-relaxed text-slate-800 lg:text-base">
												{person.qualification}
											</p>
										</div>

										<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:mt-7">
											<div>
												<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Vision</p>
												<p class="mt-2 text-left text-sm leading-relaxed text-slate-700 lg:text-base">{person.vision}</p>
											</div>
											<div>
												<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Strength</p>
												<p class="mt-2 text-left text-sm leading-relaxed text-slate-600 lg:text-base">{person.strength}</p>
											</div>
										</div>

										<p class="relative mt-5 max-w-2xl pb-10 text-left text-sm leading-relaxed text-slate-500 lg:mt-6">
											{person.detail}
											<span
												class="pointer-events-none absolute -bottom-1 left-0 right-0 z-10 bg-gradient-to-t from-slate-50 via-slate-50/90 to-transparent pt-8 text-center font-mono text-[0.625rem] uppercase tracking-[0.24em] text-slate-400"
												aria-hidden="true"
											>
												Scroll to explore
											</span>
										</p>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.leader-photo {
		border: none;
		border-radius: 0;
		box-shadow: none;
		background: transparent;
		-webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
	}

	.leader-quote {
		margin: 0;
		border-left: 3px solid var(--color-brand-green);
		padding-left: 1rem;
	}

	.leader-quote p {
		font-size: 0.9375rem;
		font-weight: 500;
		font-style: italic;
		line-height: 1.65;
		color: rgb(30 41 59);
	}

	@media (min-width: 1024px) {
		.leader-quote p {
			font-size: 1.0625rem;
		}
	}

	.leader-panel {
		background: linear-gradient(to bottom, rgb(248 250 252 / 0.72) 0%, rgb(248 250 252 / 0.92) 2.5rem, transparent 5rem);
	}

	.leader-dot.active {
		width: 2rem;
		background-color: var(--color-brand-green);
	}

	@media (prefers-reduced-motion: reduce) {
		.leadership-scroll-track {
			display: none !important;
		}

		.leadership-scroll {
			display: block !important;
		}
	}
</style>

<script>
	import { initLeadershipScroll } from "../../scripts/leadership-scroll";

	initLeadershipScroll();
</script>
