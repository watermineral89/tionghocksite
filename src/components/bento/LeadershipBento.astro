---
import SectionHeader from "../ui/SectionHeader.astro";

const leaders = [
	{
		name: "Gary Chan Kee Chong",
		initials: "GC",
		role: "Director of Operations & Logistics",
		badge: "OPS · LOG",
		photo: "/DIRECTOR GARY.jpg",
		qualification: "10+ years aerospace operations & logistics",
		quote:
			"Coming from aerospace, I don't do 'close enough.' A warehouse this size only works if every location and every count is exactly where it's supposed to be.",
		vision: "Aerospace-grade precision applied to every line of automotive inventory we move.",
		strength: "Core infrastructure, warehouse discipline, and logistics that scale without breaking.",
		detail:
			"The senior director overseeing the company's core infrastructure. Integrates aerospace-grade precision into large-scale automotive parts distribution.",
	},
	{
		name: "Rahim Chan",
		initials: "RC",
		role: "Managing Director & Chief Visionary",
		badge: "MD · VISION",
		photo: "/DIRECTOR RAHIM.jpg",
		qualification: "B.Eng (Hons) Civil Engineering — University of Nottingham",
		quote:
			"Every branch we open has to make the next one easier, not harder. That's the only kind of growth worth chasing.",
		vision: "Engineering logic driving multi-branch growth and long-term industry leadership.",
		strength: "Strategic expansion, procurement foresight, and the blueprint for Tiong Hock's next chapter.",
		detail:
			"The lead architect of Tiong Hock's expansion. He combines engineering logic with the foresight to drive our multi-branch growth and long-term industry strategy.",
	},
	{
		name: "Vince Chan Chee Hou",
		initials: "VC",
		role: "Technical Director & Systems Architect",
		badge: "TECH · STOCKPILOT",
		photo: "/DIRECTOR VINCE.jpg",
		qualification: "B.Eng (Hons) Civil Engineering — Curtin University",
		quote:
			"I built StockPilot because I was tired of guessing where stock actually was. Now the whole team can see it — and so can I.",
		vision: "Digitizing the warehouse so fitment, stock, and fulfilment run on engineering certainty.",
		strength: "StockPilot — our own in-house developed system powering inventory, picking, and fulfilment across every branch.",
		detail:
			"Lead architect and developer of StockPilot, Tiong Hock's internally built inventory and warehouse management platform.",
	},
	{
		name: "Ivan Yong",
		initials: "IY",
		role: "Director of Sales & Mechanical Engineering",
		badge: "SALES · MECH",
		photo: "/DIRECTOR IVAN.jpg",
		qualification: "B.Eng (1st Class Hons) Mechanical Engineering — UCSI University",
		quote:
			"Half my job is figuring out why a part failed before I even talk about the replacement. Get the diagnosis right and the sale takes care of itself.",
		vision: "Workshop-grade technical support — parts identified correctly, failures understood deeply.",
		strength: "Mechanical engineering rigour on the sales floor — failure analysis and fitment you can trust.",
		detail: "Expert in failure analysis and technical workshop support.",
	},
];
---

<section
	id="technical-leadership"
	class="scroll-mt-24 th-section-alt"
	aria-labelledby="technical-leadership-heading"
>
	<div class="th-container pb-10 md:pb-14">
		<SectionHeader
			eyebrow="Core leadership"
			title="Technical leadership"
			description="Engineering-led operations, procurement discipline, and systems-backed inventory."
			headingId="technical-leadership-heading"
			class="!items-start"
		/>
	</div>

	<div class="th-container pb-20 md:pb-28">
		{
			leaders.map((person, index) => (
				<article
					class:list={[
						"grid grid-cols-1 gap-8 border-b border-slate-200/80 py-12 last:border-b-0",
						"md:grid-cols-12 md:items-start md:gap-x-10 md:py-16",
					]}
				>
					<div
						class:list={[
							"md:col-span-4",
							index % 2 === 1 && "md:order-2",
						]}
					>
						<div class="overflow-hidden">
							{person.photo ? (
								<img
									src={person.photo}
									alt={person.name}
									width={640}
									height={800}
									class="leader-photo mx-auto max-h-[420px] w-auto max-w-full object-contain object-bottom md:mx-0 md:max-h-[480px]"
									loading={index === 0 ? "eager" : "lazy"}
									decoding="async"
								/>
							) : (
								<div
									class="flex h-56 items-end justify-center bg-gradient-to-t from-slate-100/80 to-transparent md:h-72 md:justify-start"
									aria-hidden="true"
								>
									<span class="translate-y-4 font-mono text-7xl font-bold tracking-wider text-slate-200">
										{person.initials}
									</span>
								</div>
							)}
						</div>
					</div>

					<div
						class:list={[
							"md:col-span-8",
							index % 2 === 1 && "md:order-1",
						]}
					>
						<p class="th-tech-badge">{person.badge}</p>
						<h3 class="mt-3 text-xl font-bold text-slate-900 lg:text-2xl">{person.name}</h3>
						<p class="mt-1 text-xs font-semibold uppercase tracking-wide text-brand-green sm:text-sm">
							{person.role}
						</p>

						<blockquote class="leader-quote mt-5 max-w-2xl">
							<p>{person.quote}</p>
						</blockquote>

						<div class="mt-5 max-w-2xl">
							<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Qualification</p>
							<p class="mt-1.5 text-left text-sm font-medium leading-relaxed text-slate-800 lg:text-base">
								{person.qualification}
							</p>
						</div>

						<div class="mt-6 grid gap-5 sm:grid-cols-2">
							<div>
								<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Vision</p>
								<p class="mt-1.5 text-left text-sm leading-relaxed text-slate-700 lg:text-base">
									{person.vision}
								</p>
							</div>
							<div>
								<p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-400">Strength</p>
								<p class="mt-1.5 text-left text-sm leading-relaxed text-slate-600 lg:text-base">
									{person.strength}
								</p>
							</div>
						</div>

						<p class="mt-5 max-w-2xl text-left text-sm leading-relaxed text-slate-500">{person.detail}</p>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.leader-photo {
		border: none;
		border-radius: 0;
		box-shadow: none;
		background: transparent;
		-webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
	}

	.leader-quote {
		margin: 0;
		border-left: 3px solid var(--color-brand-green);
		padding-left: 1rem;
	}

	.leader-quote p {
		font-size: 0.9375rem;
		font-weight: 500;
		font-style: italic;
		line-height: 1.65;
		color: rgb(30 41 59);
	}

	@media (min-width: 1024px) {
		.leader-quote p {
			font-size: 1.0625rem;
		}
	}
</style>
