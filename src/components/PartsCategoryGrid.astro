---
const wa = (message: string) => `https://wa.me/60168860864?text=${encodeURIComponent(message)}`;

const categories = [
	{
		title: "Absorbers & Suspension",
		refs: ["KYB-444134", "BSH-MTY-02R", "OEM-45201-S82"],
		body: "Full range of shock absorbers, mounting, and bushings for heavy-duty and passenger use.",
		waMsg:
			"Hello Tiong Hock — I need a fitment check for *Absorbers & Suspension*.\n\nVehicle / chassis no.: \nPart refs on hand: ",
	},
	{
		title: "Brake Systems",
		refs: ["BP-ADL-1949", "DIS-R280F", "BSH-MC-88"],
		body: "High-performance brake pads, shoes, discs, and master cylinders.",
		waMsg:
			"Hello Tiong Hock — I need a fitment check for *Brake Systems*.\n\nVehicle / chassis no.: \nPart refs on hand: ",
	},
	{
		title: "Body & Exterior",
		refs: ["LAM-HDL-81150", "BMP-FRT-521", "MIR-EG-DM2"],
		body: "Headlamps, bumpers, mirrors, and cooling components for major OEM models.",
		waMsg:
			"Hello Tiong Hock — I need a fitment check for *Body & Exterior*.\n\nVehicle / chassis no.: \nPart refs on hand: ",
	},
	{
		title: "Electrical & Alternators",
		refs: ["ALT-12V-120A-RB", "STR-428000-9290", "BAT-MF-NS70"],
		body: "New and reconditioned alternators, starters, and high-cycle batteries.",
		waMsg:
			"Hello Tiong Hock — I need a fitment check for *Electrical & Alternators*.\n\nVehicle / chassis no.: \nPart refs on hand: ",
	},
	{
		title: "Lubricants & Service",
		refs: ["SVO-CI4-15W40-20L", "FLT-OFC-90915", "ADD-DP-LMT"],
		body: "Engine oils, filters, and additives tuned for tropical fleet duty.",
		waMsg:
			"Hello Tiong Hock — I need a fitment check for *Lubricants & Service*.\n\nVehicle / chassis no.: \nPart refs on hand: ",
	},
] as const;
---

<div id="parts-categories" class="scroll-mt-24">
	<div class="flex flex-wrap items-end justify-between gap-4 border-b border-zinc-200 pb-4">
		<div>
			<p class="text-[0.65rem] font-bold uppercase tracking-[0.28em] text-zinc-600">Technical catalog · Line index</p>
			<h2 class="mt-2 text-lg font-bold uppercase tracking-[0.12em] text-zinc-900 sm:text-xl">Spare part types</h2>
		</div>
		<p class="max-w-sm text-right font-mono text-[10px] leading-relaxed text-zinc-500 sm:text-[11px]">
			<span class="text-zinc-600">DOC-TH-KCH-REV</span> 2026-01 · <span class="text-zinc-600">SHEET</span> A-17
		</p>
	</div>

	<div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5 lg:gap-4">
		{
			categories.map((c, i) => (
				<article
					class:list={[
						"relative flex flex-col border border-zinc-200 bg-white p-5",
						"lg:col-span-1",
						i === 4 && "lg:col-start-5",
					]}
				>
					<span class="inline-flex w-fit border border-[#DA251C]/50 bg-[#DA251C] px-2 py-1 text-[0.625rem] font-bold uppercase leading-none tracking-[0.14em] text-white">
						OEM / GENUINE AVAILABLE
					</span>
					<h3 class="mt-5 text-sm font-bold uppercase tracking-[0.08em] text-[#DA251C] sm:text-base">{c.title}</h3>
					<div class="mt-3 border border-zinc-200 bg-white px-3 py-2 font-mono text-[10px] leading-relaxed text-zinc-600 sm:text-[11px]">
						<span class="text-zinc-600">LINE REF</span> {c.refs.join(" · ")}
					</div>
					<p class="mt-4 flex-1 text-justify text-sm leading-relaxed text-zinc-700">{c.body}</p>
					<a
						href={wa(c.waMsg)}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 inline-flex w-full items-center justify-center border border-[#DA251C] bg-transparent px-4 py-2.5 text-center text-[0.7rem] font-bold uppercase tracking-[0.12em] text-[#DA251C] transition hover:bg-[#DA251C] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#DA251C]"
					>
						Check Fitment via WhatsApp
					</a>
				</article>
			))
		}
	</div>
</div>
