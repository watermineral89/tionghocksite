---
---

<section id="stock-search" class="parts-search scroll-mt-24">
	<div class="parts-search__hero">
		<div class="th-container parts-search__hero-inner" data-animate="fade-up">
			<h1 class="parts-search__headline">
				Find the right part.<br />
				<span class="parts-search__headline-accent">Fast.</span>
			</h1>
			<p class="parts-search__subhead">
				Search by part number, brand, vehicle or description.
			</p>
		</div>
	</div>

	<div class="parts-search__panel">
		<div class="th-container">
			<div class="parts-search__root" data-stock-search-root data-animate="fade-up">
				<form
					data-stock-search-form
					class="parts-search__form"
					role="search"
					aria-label="Stock search"
				>
					<label class="sr-only" for="stock-search-input">Search parts</label>
					<input
						id="stock-search-input"
						data-stock-search-input
						type="search"
						name="q"
						autocomplete="off"
						spellcheck="false"
						placeholder="KYB · DENSO · 04465-… · brake pad · R134a"
						class="parts-search__input"
					/>
					<button type="submit" class="parts-search__submit">Search</button>
				</form>

				<div class="parts-search__hints">
					<span>In stock</span>
					<span>Limited</span>
					<span>Enquire</span>
					<span class="parts-search__hints-note">Pricing via WhatsApp</span>
				</div>

				<p data-stock-search-status class="parts-search__status" hidden aria-live="polite">
					Searching…
				</p>
				<p data-stock-search-meta class="parts-search__meta">
					Type at least 2 characters — try a SKU, brand, or OEM reference.
				</p>

				<div data-stock-search-results class="parts-search__results" aria-live="polite"></div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initStockSearch } from "../scripts/stock-search";

	document.querySelectorAll<HTMLElement>("[data-stock-search-root]").forEach((root) => initStockSearch(root));
</script>

<style>
	.parts-search {
		background: #0f172a;
		color: #f8fafc;
	}

	.parts-search__hero {
		padding: clamp(2.5rem, 6vw, 3.5rem) 0 0;
	}

	.parts-search__hero-inner {
		max-width: 48rem;
	}

	.parts-search__headline {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.parts-search__headline-accent {
		color: #4ade80;
	}

	.parts-search__subhead {
		margin: 1rem 0 0;
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.5;
		color: #94a3b8;
	}

	.parts-search__panel {
		padding: 1.75rem 0 clamp(2.5rem, 5vw, 3.5rem);
	}

	.parts-search__root {
		max-width: 52rem;
	}

	.parts-search__form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	@media (min-width: 640px) {
		.parts-search__form {
			flex-direction: row;
		}
	}

	.parts-search__input {
		flex: 1;
		min-height: 3.25rem;
		border: 1px solid rgb(255 255 255 / 0.12);
		background: rgb(255 255 255 / 0.06);
		padding: 0 1.15rem;
		font-size: 1rem;
		color: #fff;
		outline: none;
		transition: border-color 0.15s, background-color 0.15s;
	}

	.parts-search__input::placeholder {
		color: #64748b;
	}

	.parts-search__input:focus {
		border-color: #4ade80;
		background: rgb(255 255 255 / 0.08);
		box-shadow: 0 0 0 3px rgb(74 222 128 / 0.15);
	}

	.parts-search__submit {
		min-height: 3.25rem;
		padding: 0 1.75rem;
		border: 0;
		background: var(--color-brand-green);
		font-size: 0.9rem;
		font-weight: 700;
		color: #fff;
		cursor: pointer;
		transition: background-color 0.15s;
	}

	.parts-search__submit:hover {
		background: color-mix(in oklab, var(--color-brand-green) 88%, black);
	}

	.parts-search__hints {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 1rem;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.parts-search__hints span:not(.parts-search__hints-note) {
		padding: 0.2rem 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.12);
		color: #cbd5e1;
	}

	.parts-search__hints-note {
		margin-left: auto;
		color: #64748b;
		text-transform: none;
		letter-spacing: 0;
		font-weight: 500;
		font-size: 0.75rem;
	}

	.parts-search__status {
		margin: 0.75rem 0 0;
		font-size: 0.75rem;
		color: #94a3b8;
	}

	.parts-search__meta {
		margin: 0.75rem 0 0;
		font-size: 0.85rem;
		color: #64748b;
	}

	.parts-search__results {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.parts-search__results :global(.parts-result) {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.15rem 1.25rem;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(255 255 255 / 0.04);
	}

	@media (min-width: 640px) {
		.parts-search__results :global(.parts-result) {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}

	.parts-search__results :global(.parts-result__body) {
		min-width: 0;
		flex: 1;
	}

	.parts-search__results :global(.parts-result__top) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.parts-search__results :global(.parts-result__sku) {
		margin: 0;
		font-family: ui-monospace, monospace;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: #4ade80;
	}

	.parts-search__results :global(.parts-result__name) {
		margin: 0.5rem 0 0;
		font-size: 1rem;
		font-weight: 600;
		color: #f8fafc;
	}

	.parts-search__results :global(.parts-result__meta) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.35rem 0 0;
		font-size: 0.8rem;
		color: #94a3b8;
	}

	.parts-search__results :global(.parts-result__wa) {
		flex-shrink: 0;
		justify-content: center;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
