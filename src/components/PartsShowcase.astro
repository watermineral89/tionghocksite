---
const lines = [
	"Engine · gaskets, pumps, belts, filtration",
	"Brake · discs, pads, hydraulics, ABS sensors",
	"Drivetrain · differentials, UJ kits, hubs",
	"Electrical · alternators, starters, lighting",
	"Chassis · bushes, arms, dampers, steering",
];
---

<section id="parts" class="scroll-mt-24 border-b border-zinc-200 bg-white">
	<div class="th-container py-16 lg:py-20">
		<div class="grid gap-10 lg:grid-cols-12 lg:items-start">
			<div class="lg:col-span-5">
				<p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand">Fast-moving depth</p>
				<h2 class="mt-3 text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl">Parts desk that understands duty cycles.</h2>
				<p class="mt-4 text-lg text-zinc-700">
					High-velocity categories are stocked for immediate dispatch. Specialist assemblies are sourced with lead-time
					transparency—no mystery ETAs.
				</p>
			</div>
			<ul class="lg:col-span-7 lg:pl-8">
				{
					lines.map((line) => (
						<li class="flex items-start gap-4 border-t border-zinc-200 py-4 first:border-t-0 first:pt-0 lg:first:pt-0">
							<span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
							<span class="text-base font-medium text-zinc-900">{line}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
