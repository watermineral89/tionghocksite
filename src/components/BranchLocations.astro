---
const waHref = (waPhone: string, message: string) =>
	`https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`;

const branches = [
	{
		heading: "HQ · Matang Jaya",
		legalName: "Tiong Hock Auto Parts (Kch) Sdn Bhd",
		address: "Sublot 37, Phase 12, Jln Matang Jaya, Taman Lee Ling, 93050 Kuching",
		phone: "082-649 433",
		phoneTel: "+6082649433",
		waPhone: "60168860864",
		waMessage:
			"Hello Tiong Hock Auto Parts (Kch) Sdn Bhd — WhatsApp enquiry for *HQ / Matang Jaya*.\n\nParts / vehicle: ",
	},
	{
		heading: "Automart · Kota Samarahan",
		legalName: "Tiong Hock AutoMart Sdn Bhd",
		address: "Uni Central Commercial Centre, Lot 27, Ground Floor, 94300 Kota Samarahan",
		phone: "082-375 775",
		phoneTel: "+6082375775",
		waPhone: "60102130132",
		waMessage:
			"Hello Tiong Hock AutoMart — WhatsApp enquiry for *Uni Central, Kota Samarahan*.\n\nParts / vehicle: ",
	},
];
---

<section id="contact" class="scroll-mt-24 border-b border-slate-200 bg-white py-16 md:py-20">
	<div class="th-container">
		<div data-animate="fade-up">
			<p class="th-tech-badge">Branch network</p>
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
				Branch Locations in Matang Jaya &amp; Kota Samarahan
			</h2>
			<p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">
				Two active outlets across Matang Jaya and Kota Samarahan — phone or WhatsApp for parts enquiries.
			</p>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2" data-animate="stagger-parent">
			{
				branches.map((b) => (
					<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
						<h3 class="text-sm font-bold uppercase tracking-wide text-brand-green">{b.heading}</h3>
						<p class="mt-2 text-xs font-medium text-slate-500">{b.legalName}</p>
						<address class="mt-4 not-italic text-left text-sm leading-relaxed text-slate-600">{b.address}</address>
						<p class="mt-4 text-sm">
							<span class="text-slate-500">Tel</span>{" "}
							<a class="font-medium text-slate-900 underline-offset-2 hover:text-brand-green hover:underline" href={`tel:${b.phoneTel}`}>
								{b.phone}
							</a>
						</p>
						<a
							href={waHref(b.waPhone, b.waMessage)}
							target="_blank"
							rel="noopener noreferrer"
							class="th-cta-wa mt-5 w-full sm:mt-auto sm:pt-5"
						>
							WhatsApp Inquiry
						</a>
					</article>
				))
			}
		</div>

		<div class="mt-10" data-animate="fade-up">
			<p class="text-xs font-semibold uppercase tracking-wide text-brand-green">Find us</p>
			<h3 class="mt-2 text-lg font-bold tracking-tight text-slate-900 sm:text-xl">
				Matang Jaya HQ
			</h3>
			<div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5291.791400552243!2d110.30063600000001!3d1.571454!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31fb07dbb4144f5d%3A0xbaa60fc8c64e909c!2sTiong%20Hock%20Auto%20Parts(Kch)Sdn%20Bhd!5e1!3m2!1sen!2smy!4v1788319114904!5m2!1sen!2smy"
					class="aspect-[4/3] h-auto w-full border-0 sm:aspect-[16/9]"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
					title="Tiong Hock Auto Parts (Kch) Sdn Bhd — Matang Jaya HQ on Google Maps"
				></iframe>
			</div>
		</div>

		<p
			class="mt-4 flex items-center justify-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-center font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-slate-500 sm:text-xs"
			data-animate="fade-up"
		>
			Coming Soon: 3rd Location in Development
		</p>
	</div>
</section>
