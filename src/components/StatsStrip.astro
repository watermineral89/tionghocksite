---
const cards = [
	{
		title: "Ready stock",
		body: "HQ in Matang Jaya plus Automart at Uni Central, Kota Samarahan—maximum availability and faster pickup across outlets.",
	},
	{
		title: "Proven track record",
		body: "Over 14 years supporting workshops with consistent identification, fair pricing, and dependable supply.",
	},
	{
		title: "Deep inventory",
		body: "Broad SKU coverage across fast-moving lines so you spend less time chasing stock across suppliers.",
	},
	{
		title: "Same-day fulfilment",
		body: "Cut-off windows on core movers aligned to workshop schedules—pick up or arrange dispatch the same day when available.",
	},
];
---

<section class="border-b border-zinc-200 bg-white" aria-labelledby="reliable-affordable-heading">
	<div class="th-container py-12 lg:py-14">
		<div class="max-w-2xl">
			<p class="text-xs font-bold uppercase tracking-[0.26em] text-brand">Matang &amp; Samarahan · Sarawak</p>
			<h2 id="reliable-affordable-heading" class="mt-3 text-2xl font-bold uppercase tracking-[0.14em] text-zinc-900 sm:text-3xl">
				Reliable &amp; affordable
			</h2>
			<p class="mt-3 text-sm leading-relaxed text-zinc-700 sm:text-base">
				Visit our Matang Jaya HQ or Automart at Kota Samarahan for reliable parts and fair prices.
			</p>
		</div>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				cards.map((c) => (
					<article class="flex flex-col border border-zinc-200 bg-white p-5">
						<h3 class="text-sm font-bold uppercase tracking-[0.12em] text-brand">{c.title}</h3>
						<p class="mt-3 text-justify text-sm leading-relaxed text-zinc-700">{c.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
