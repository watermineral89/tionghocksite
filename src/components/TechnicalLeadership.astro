		name: "Gary Chan Kee Chong",
		role: "Director of Operations & Logistics",
		detail:
			"The senior director overseeing the company’s core infrastructure. Integrates 10 years of Aerospace-grade precision into large-scale automotive parts distribution.",
	},
	{
		name: "Rahim Chan",
		role: "Managing Director & Chief Visionary",
