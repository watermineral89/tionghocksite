---

<section
	id="technical-leadership"
	class="scroll-mt-24 border-b border-zinc-200 bg-white py-14 sm:py-16 lg:py-20"
	aria-labelledby="technical-leadership-heading"
>
	<div class="th-container">
		<p class="text-[0.65rem] font-bold uppercase tracking-[0.28em] text-[#DA251C]">Core leadership</p>
		<h2 id="technical-leadership-heading" class="mt-3 text-2xl font-bold uppercase tracking-[0.12em] text-zinc-900 sm:text-3xl">
			Technical leadership
		</h2>
		<p class="mt-4 max-w-3xl text-justify text-sm leading-relaxed text-zinc-700 sm:text-base">
			Engineering-led operations, procurement discipline, and systems-backed inventory—built for workshops that treat fitment and
			fulfilment as engineering problems, not counter luck.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
			{
				leaders.map((person) => (
					<article class="flex flex-col border border-zinc-200 bg-white p-5 transition-colors hover:border-red-600">
						<h3 class="text-lg font-bold leading-snug text-zinc-900">{person.name}</h3>
						<p class="mt-2 font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[#DA251C] sm:text-sm">
							{person.role}
						</p>
						<p class="mt-4 flex-1 text-justify font-mono text-xs leading-relaxed text-zinc-600 sm:text-sm">{person.detail}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
