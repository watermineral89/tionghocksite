---
import DistributionMap from "../DistributionMap.astro";

const stockPilotHero = encodeURI("/ChatGPT Image Sep 1, 2026, 09_45_43 PM.png");
const stockPilotUi = "/stockpilot-technology.jpg";
const warehouseImg = "/stockpilot-warehouse.png";
const partsImg = "/ACONGAS.jpg";
const ivanImg = encodeURI("/DIRECTOR IVAN.jpg");

const journey = [
	{
		no: "01",
		title: "Identify",
		question: "What part is actually required?",
		detail: "Part numbers, brands, OEM references and applications.",
	},
	{
		no: "02",
		title: "Verify",
		question: "Will it actually fit?",
		detail: "Vehicle application, technical specifications and alternatives.",
	},
	{
		no: "03",
		title: "Locate",
		question: "Do we have it — and where?",
		detail: "Inventory availability and warehouse location through StockPilot.",
	},
	{
		no: "04",
		title: "Fulfil",
		question: "Can we pick it accurately?",
		detail: "Warehouse picking, checking and packing.",
	},
	{
		no: "05",
		title: "Deliver",
		question: "Can we get it there?",
		detail: "Branch network, workshop supply and regional distribution.",
	},
];

const stockPilotMetrics = [
	{ value: "50,000+", label: "Active line items", note: "Managed in StockPilot" },
	{ value: "Real-time", label: "Inventory", note: "Availability visibility" },
	{ value: "2", label: "Branches", note: "Matang Jaya & Samarahan" },
	{ value: "Movement", label: "Stock tracking", note: "Incoming, outgoing & adjustments" },
];

const warehouseFlow = ["Order", "StockPilot", "Location", "Pick", "Check", "Pack", "Dispatch"];

const warehouseOps = [
	"Inventory control",
	"Location management",
	"Barcode scanning",
	"Picking",
	"Checking",
	"Packing",
	"Dispatch",
];

const partsPoints = [
	"OEM & genuine parts",
	"Aftermarket alternatives",
	"Part-number identification",
	"Technical cross-reference",
	"Vehicle application",
	"Fitment support",
];

const technicalPoints = [
	"Mechanical troubleshooting",
	"Failure analysis",
	"Correct-part identification",
	"Installation considerations",
	"Workshop counter support",
];

const stats = [
	{ value: "50,000+", label: "Active line items" },
	{ value: "2", label: "Branch locations" },
	{ value: "4", label: "Decades in Kuching", suffix: "+" },
	{ value: "Sarawak", label: "Regional distribution", isText: true },
];
---

<section id="capabilities" class="cap-page scroll-mt-24" aria-labelledby="cap-hero-heading">
	<!-- 1. HERO -->
	<header class="cap-hero">
		<div class="cap-hero__grid th-container">
			<div class="cap-hero__copy" data-animate="fade-up">
				<p class="cap-kicker">Capabilities</p>
				<h1 id="cap-hero-heading" class="cap-hero__headline">
					<span class="cap-hero__line">From &ldquo;what part?&rdquo;</span>
					<span class="cap-hero__line cap-hero__line--accent">to &ldquo;delivered.&rdquo;</span>
				</h1>
				<p class="cap-hero__support">The capability behind every part we supply.</p>
				<p class="cap-hero__chain" aria-label="Operational journey">
					Identify <span aria-hidden="true">→</span> Verify <span aria-hidden="true">→</span> Locate
					<span aria-hidden="true">→</span> Fulfil <span aria-hidden="true">→</span> Deliver
				</p>
			</div>
			<div class="cap-hero__visual" data-animate="fade-up">
				<img
					src={warehouseImg}
					width={1024}
					height={572}
					alt="StockPilot warehouse operations — organised shelving, barcode scanner and inventory control"
					class="cap-hero__img"
					loading="eager"
					decoding="async"
				/>
				<div class="cap-hero__gridlines" aria-hidden="true"></div>
			</div>
		</div>
	</header>

	<!-- 2. OPERATIONAL JOURNEY -->
	<section class="cap-journey" aria-labelledby="cap-journey-heading">
		<div class="th-container">
			<div class="cap-journey__intro" data-animate="fade-up">
				<p class="cap-kicker cap-kicker--dark">Operational journey</p>
				<h2 id="cap-journey-heading" class="cap-section-title">
					Five things have to happen before a part reaches the customer.
				</h2>
			</div>

			<ol class="cap-journey__pipeline" data-animate="stagger-parent">
				{
					journey.map((step, i) => (
						<li class="cap-journey__stage">
							{i > 0 && <span class="cap-journey__connector" aria-hidden="true"></span>}
							<div class="cap-journey__stage-inner">
								<p class="cap-journey__no">{step.no}</p>
								<h3 class="cap-journey__title">{step.title}</h3>
								<p class="cap-journey__question">{step.question}</p>
								<p class="cap-journey__detail">{step.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 3. STOCKPILOT -->
	<section id="stockpilot" class="cap-stockpilot scroll-mt-24" aria-labelledby="cap-stockpilot-heading">
		<div class="th-container cap-stockpilot__layout">
			<div class="cap-stockpilot__copy" data-animate="fade-up">
				<p class="cap-kicker cap-kicker--light">The system behind the operation</p>
				<h2 id="cap-stockpilot-heading" class="cap-stockpilot__name">StockPilot</h2>
				<p class="cap-stockpilot__tagline">
					Know what you have.<br />
					Know where it is.<br />
					Know what moves.
				</p>
				<p class="cap-stockpilot__body">
					StockPilot connects inventory, shelf locations and stock movement — the digital infrastructure behind
					identify, verify, locate, fulfil and deliver.
				</p>
				<dl class="cap-metrics">
					{
						stockPilotMetrics.map((m) => (
							<div class="cap-metrics__item">
								<dt class="cap-metrics__value">{m.value}</dt>
								<dd>
									<span class="cap-metrics__label">{m.label}</span>
									<span class="cap-metrics__note">{m.note}</span>
								</dd>
							</div>
						))
					}
				</dl>
			</div>
			<div class="cap-stockpilot__visual" data-animate="fade-up">
				<div class="cap-stockpilot__screenshot-wrap">
					<img
						src={stockPilotHero}
						width={1024}
						height={576}
						alt="StockPilot ERP dashboard — stock search, inventory and branch visibility"
						class="cap-stockpilot__screenshot"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="cap-stockpilot__ui-wrap">
					<img
						src={stockPilotUi}
						width={512}
						height={317}
						alt="StockPilot interface close-up — part numbers, brands, models and stock quantities"
						class="cap-stockpilot__ui"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. PARTS & FITMENT -->
	<section id="parts-fitment" class="cap-editorial cap-editorial--light scroll-mt-24" aria-labelledby="cap-parts-heading">
		<div class="th-container cap-editorial__grid">
			<div class="cap-editorial__visual" data-animate="fade-up">
				<img
					src={partsImg}
					width={800}
					height={600}
					alt="Automotive parts and product lines at Tiong Hock"
					class="cap-editorial__img"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="cap-editorial__copy" data-animate="fade-up">
				<h2 id="cap-parts-heading" class="cap-editorial__headline">
					Right part.<br />
					<span class="cap-editorial__headline-accent">Right application.</span>
				</h2>
				<p class="cap-editorial__lede">
					We help customers identify the correct part — not simply sell whatever is on the shelf.
				</p>
				<ul class="cap-tags">
					{partsPoints.map((p) => <li>{p}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- 5. TECHNICAL EXPERTISE -->
	<section id="technical-support" class="cap-editorial cap-editorial--dark scroll-mt-24" aria-labelledby="cap-tech-heading">
		<div class="th-container cap-editorial__grid cap-editorial__grid--reverse">
			<div class="cap-editorial__visual" data-animate="fade-up">
				<img
					src={ivanImg}
					width={640}
					height={800}
					alt="Ivan Yong — Director of Sales & Mechanical Engineering, technical workshop support"
					class="cap-editorial__img cap-editorial__img--portrait"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="cap-editorial__copy" data-animate="fade-up">
				<p class="cap-kicker cap-kicker--light">Technical expertise</p>
				<h2 id="cap-tech-heading" class="cap-editorial__headline cap-editorial__headline--light">
					Sometimes the part<br />isn&rsquo;t the problem.
				</h2>
				<p class="cap-editorial__lede cap-editorial__lede--light">
					We understand why the part failed — not just which part to sell. Mechanical engineering on the counter,
					not generic &ldquo;technical support.&rdquo;
				</p>
				<ul class="cap-tags cap-tags--light">
					{technicalPoints.map((p) => <li>{p}</li>)}
				</ul>
				<p class="cap-credit">Ivan Yong — Director of Sales &amp; Mechanical Engineering</p>
			</div>
		</div>
	</section>

	<!-- 6. WAREHOUSE -->
	<section id="warehouse" class="cap-warehouse scroll-mt-24" aria-labelledby="cap-warehouse-heading">
		<div class="cap-warehouse__visual-wrap">
			<img
				src={warehouseImg}
				width={1024}
				height={572}
				alt="StockPilot warehouse control — structured locations, barcode scanner and picking operations"
				class="cap-warehouse__bg"
				loading="lazy"
				decoding="async"
			/>
			<div class="cap-warehouse__overlay"></div>
		</div>
		<div class="th-container cap-warehouse__content">
			<div data-animate="fade-up">
				<h2 id="cap-warehouse-heading" class="cap-warehouse__headline">
					Thousands of parts.<br />
					<span>One controlled operation.</span>
				</h2>
				<div class="cap-flow-strip" aria-label="Warehouse fulfilment flow">
					{
						warehouseFlow.map((step, i) => (
							<span class="cap-flow-strip__group">
								{i > 0 && <span class="cap-flow-strip__arrow" aria-hidden="true">→</span>}
								<span class="cap-flow-strip__step">{step}</span>
							</span>
						))
					}
				</div>
				<ul class="cap-tags cap-tags--on-dark">
					{warehouseOps.map((op) => <li>{op}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- 7. REGIONAL DISTRIBUTION -->
	<DistributionMap id="distribution" />

	<!-- 8. STATS -->
	<section class="cap-stats" aria-label="Capability at scale">
		<div class="th-container">
			<dl class="cap-stats__grid" data-animate="stagger-parent">
				{
					stats.map((s) => (
						<div class="cap-stats__item">
							<dt class="cap-stats__value">
								{s.value}
								{s.suffix && <span class="cap-stats__suffix">{s.suffix}</span>}
							</dt>
							<dd class="cap-stats__label">{s.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- 9. CTA -->
	<section class="cap-cta" aria-labelledby="cap-cta-heading">
		<div class="th-container cap-cta__inner" data-animate="fade-up">
			<h2 id="cap-cta-heading" class="cap-cta__title">Need a part?</h2>
			<p class="cap-cta__support">From identification to delivery, we&rsquo;re built to move it.</p>
			<div class="cap-cta__actions">
				<a href="/search" class="cap-btn cap-btn--primary">Find a part</a>
				<a href="/contact" class="cap-btn cap-btn--ghost">Contact our team</a>
			</div>
		</div>
	</section>
</section>

<style>
	.cap-page {
		background: rgb(248 250 252);
		color: rgb(15 23 42);
	}

	.cap-kicker {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-brand-green);
	}

	.cap-kicker--dark {
		color: rgb(100 116 139);
	}

	.cap-kicker--light {
		color: rgb(134 239 172);
	}

	/* —— HERO —— */
	.cap-hero {
		background: rgb(12 14 17);
		color: rgb(248 250 252);
		padding-block: clamp(3rem, 8vw, 5rem);
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.cap-hero__grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.cap-hero__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			gap: 3.5rem;
		}
	}

	.cap-hero__headline {
		margin-top: 1.25rem;
		font-size: clamp(2.25rem, 6.5vw, 4.25rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.03em;
		text-transform: uppercase;
	}

	.cap-hero__line {
		display: block;
	}

	.cap-hero__line--accent {
		color: rgb(201 162 39);
	}

	.cap-hero__support {
		margin-top: 1.25rem;
		font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
		font-weight: 500;
		color: rgb(203 213 225);
	}

	.cap-hero__chain {
		margin-top: 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(148 163 184);
		line-height: 1.8;
	}

	.cap-hero__chain span {
		color: rgb(71 85 105);
		margin-inline: 0.15em;
	}

	.cap-hero__visual {
		position: relative;
		overflow: hidden;
	}

	.cap-hero__img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.cap-hero__gridlines {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
		background-size: 32px 32px;
		pointer-events: none;
	}

	/* —— JOURNEY —— */
	.cap-journey {
		padding-block: clamp(3.5rem, 8vw, 5.5rem);
		background: white;
		border-bottom: 1px solid rgb(226 232 240);
	}

	.cap-section-title {
		margin-top: 0.75rem;
		max-width: 36rem;
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.cap-journey__intro {
		margin-bottom: 2.5rem;
	}

	.cap-journey__pipeline {
		display: flex;
		flex-direction: column;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (min-width: 1024px) {
		.cap-journey__pipeline {
			flex-direction: row;
			align-items: stretch;
		}
	}

	.cap-journey__stage {
		position: relative;
		flex: 1;
	}

	.cap-journey__connector {
		display: block;
		width: 2px;
		height: 1.5rem;
		margin-inline: auto;
		background: linear-gradient(180deg, var(--color-brand-green), rgb(226 232 240));
	}

	@media (min-width: 1024px) {
		.cap-journey__connector {
			position: absolute;
			top: 2.75rem;
			right: -0.5rem;
			width: 1rem;
			height: 2px;
			margin: 0;
			background: linear-gradient(90deg, var(--color-brand-green), rgb(203 213 225));
			z-index: 1;
		}

		.cap-journey__stage:last-child .cap-journey__connector {
			display: none;
		}
	}

	.cap-journey__stage-inner {
		padding: 1.5rem 0;
		border-top: 2px solid rgb(15 23 42);
	}

	@media (min-width: 1024px) {
		.cap-journey__stage-inner {
			padding: 1.5rem 1rem 0 0;
		}

		.cap-journey__stage:not(:first-child) .cap-journey__stage-inner {
			padding-left: 1rem;
		}
	}

	.cap-journey__no {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: rgb(148 163 184);
	}

	.cap-journey__title {
		margin-top: 0.5rem;
		font-size: 1.125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-brand-green);
	}

	.cap-journey__question {
		margin-top: 0.5rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: rgb(15 23 42);
	}

	.cap-journey__detail {
		margin-top: 0.375rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: rgb(100 116 139);
	}

	/* —— STOCKPILOT —— */
	.cap-stockpilot {
		background: rgb(10 12 15);
		color: rgb(248 250 252);
		padding-block: clamp(3.5rem, 8vw, 6rem);
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.cap-stockpilot__layout {
		display: grid;
		gap: 3rem;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.cap-stockpilot__layout {
			grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
			gap: 3.5rem;
		}
	}

	.cap-stockpilot__name {
		margin-top: 0.75rem;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.cap-stockpilot__tagline {
		margin-top: 1rem;
		font-size: clamp(1.125rem, 2.4vw, 1.5rem);
		font-weight: 600;
		line-height: 1.35;
		color: rgb(201 162 39);
	}

	.cap-stockpilot__body {
		margin-top: 1.25rem;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: rgb(203 213 225);
		max-width: 28rem;
	}

	.cap-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(255 255 255 / 0.08);
	}

	.cap-metrics__item {
		margin: 0;
	}

	.cap-metrics__value {
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.1;
		color: white;
	}

	.cap-metrics__label {
		display: block;
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(134 239 172);
	}

	.cap-metrics__note {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.75rem;
		color: rgb(148 163 184);
	}

	.cap-stockpilot__visual {
		display: grid;
		gap: 1rem;
	}

	.cap-stockpilot__screenshot-wrap {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(0 0 0 / 0.4);
	}

	.cap-stockpilot__screenshot {
		display: block;
		width: 100%;
		min-width: 640px;
		height: auto;
	}

	@media (max-width: 767px) {
		.cap-stockpilot__screenshot {
			min-width: 720px;
		}
	}

	.cap-stockpilot__ui-wrap {
		max-width: 22rem;
		margin-left: auto;
		border: 1px solid rgb(255 255 255 / 0.08);
	}

	.cap-stockpilot__ui {
		display: block;
		width: 100%;
		height: auto;
	}

	/* —— EDITORIAL SECTIONS —— */
	.cap-editorial {
		padding-block: clamp(3.5rem, 8vw, 5.5rem);
		border-bottom: 1px solid rgb(226 232 240);
	}

	.cap-editorial--light {
		background: rgb(248 250 252);
	}

	.cap-editorial--dark {
		background: rgb(15 17 20);
		color: rgb(248 250 252);
	}

	.cap-editorial__grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.cap-editorial__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 4rem;
		}

		.cap-editorial__grid--reverse .cap-editorial__visual {
			order: 2;
		}

		.cap-editorial__grid--reverse .cap-editorial__copy {
			order: 1;
		}
	}

	.cap-editorial__img {
		display: block;
		width: 100%;
		height: auto;
	}

	.cap-editorial__img--portrait {
		max-height: 32rem;
		object-fit: contain;
		object-position: bottom;
	}

	.cap-editorial__headline {
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.cap-editorial__headline--light {
		color: white;
	}

	.cap-editorial__headline-accent {
		color: var(--color-brand-green);
	}

	.cap-editorial--dark .cap-editorial__headline-accent {
		color: rgb(134 239 172);
	}

	.cap-editorial__lede {
		margin-top: 1.25rem;
		max-width: 32rem;
		font-size: 1rem;
		line-height: 1.65;
		color: rgb(71 85 105);
	}

	.cap-editorial__lede--light {
		color: rgb(203 213 225);
	}

	.cap-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.cap-tags li {
		padding: 0.4rem 0.75rem;
		border: 1px solid rgb(226 232 240);
