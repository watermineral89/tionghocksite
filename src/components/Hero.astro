---
import MagneticButton from "./ui/MagneticButton.astro";

interface Props {
	eyebrow?: string;
	title?: string;
	description?: string;
	primaryHref?: string;
	primaryLabel?: string;
	whatsappHref?: string;
	whatsappLabel?: string;
}

const {
	eyebrow = "Parts specialist",
	title = "High-Availability Spare Parts for Commercial & Passenger Fleets.",
	description = "",
	primaryHref = "/parts",
	primaryLabel = "View Parts Categories",
	whatsappHref = `https://wa.me/6082649433?text=${encodeURIComponent("Hello Tiong Hock — I have a parts inquiry.\n\nVehicle / chassis no.: \nParts needed: ")}`,
	whatsappLabel = "Direct WhatsApp Inquiry",
} = Astro.props;

const stats = [
	{ value: "50K+", label: "Line items" },
	{ value: "40", label: "Dedicated staff" },
	{ value: "2", label: "Active branches" },
];
---

<section class="relative isolate min-h-[85dvh] overflow-hidden border-b border-slate-200 bg-slate-50">
	<div
		data-parallax
		class="pointer-events-none absolute inset-0 opacity-[0.4]"
		aria-hidden="true"
		style="background-image: linear-gradient(to right, rgba(15,23,42,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(15,23,42,0.03) 1px, transparent 1px); background-size: 48px 48px;"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-24 top-1/2 h-[min(80vw,520px)] w-[min(80vw,520px)] -translate-y-1/2 rounded-full bg-emerald-100/60 blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="th-container relative flex min-h-[85dvh] flex-col justify-center py-20 md:py-24">
		<div class="grid items-end gap-12 lg:grid-cols-12">
			<div class="lg:col-span-7" data-animate="fade-up">
				<p class="th-tech-badge">{eyebrow}</p>
				<h1 class="mt-6 text-4xl font-black leading-[1.02] tracking-tight text-slate-900 sm:text-5xl lg:text-7xl">
					{title}
				</h1>
				{
					description ? (
						<p class="mt-6 max-w-xl text-justify text-base font-normal leading-relaxed text-slate-600 sm:text-lg">
							{description}
						</p>
					) : null
				}
				<div class="mt-10 flex flex-wrap items-center gap-4">
					<MagneticButton href={primaryHref} variant="primary">{primaryLabel}</MagneticButton>
					<MagneticButton href={whatsappHref} variant="wa" external>{whatsappLabel}</MagneticButton>
				</div>
			</div>

			<div class="grid grid-cols-3 gap-3 lg:col-span-5" data-animate="stagger-parent">
				{
					stats.map((stat) => (
						<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-2xl font-black text-brand-green sm:text-3xl">{stat.value}</p>
							<p class="mt-1 font-mono text-[0.625rem] font-medium uppercase tracking-wider text-slate-500 sm:text-xs">
								{stat.label}
							</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="mt-16 flex justify-center" aria-hidden="true">
			<div class="flex flex-col items-center gap-2 text-slate-400">
				<span class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.2em]">Scroll</span>
				<svg class="h-5 w-5 animate-bounce text-brand-green/70" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
				</svg>
			</div>
		</div>
	</div>
</section>
