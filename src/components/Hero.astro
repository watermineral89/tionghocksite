---
import MagneticButton from "./ui/MagneticButton.astro";

interface Props {
	eyebrow?: string;
	title?: string;
	location?: string;
	description?: string;
	primaryHref?: string;
	primaryLabel?: string;
	whatsappHref?: string;
	whatsappLabel?: string;
}

const {
	eyebrow = "TIONG HOCK AUTO PARTS",
	title = "Automotive Spare Parts Supplier in Kuching",
	location = "Matang & Samarahan",
	description =
		"50,000+ active line items. Genuine & OEM parts for workshops and fleets across Matang Jaya, Kuching & Kota Samarahan.",
	primaryHref = "/parts",
	primaryLabel = "Browse Parts",
	whatsappHref = `https://wa.me/60168860864?text=${encodeURIComponent(
		"Hello Tiong Hock — I have a parts inquiry.\n\nVehicle / chassis no.: \nParts needed: "
	)}`,
	whatsappLabel = "WhatsApp Inquiry",
} = Astro.props;

const stats = [
	{ value: "50K+", label: "Line items" },
	{ value: "40", label: "Dedicated staff" },
	{ value: "2", label: "Active branches" },
];
---

<section
	class="relative isolate min-h-[85dvh] overflow-hidden border-b border-slate-200 bg-slate-50"
>
	<div
		data-parallax
		class="pointer-events-none absolute inset-0 opacity-[0.4]"
		aria-hidden="true"
		style="
			background-image:
				linear-gradient(to right, rgba(15,23,42,0.04) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(15,23,42,0.03) 1px, transparent 1px);
			background-size: 48px 48px;
		"
	>
	</div>

	<div
		class="pointer-events-none absolute -right-16 top-1/2 h-[min(70vw,520px)] w-[min(70vw,520px)] -translate-y-1/2 rounded-full bg-[color-mix(in_oklab,var(--color-brand-lime)_28%,white)] blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="hero-shell relative flex min-h-[85dvh] flex-col justify-center py-20 md:py-24">
		<div class="hero-grid">
			<div class="hero-copy min-w-0" data-animate="fade-up">
				<p class="th-tech-badge">{eyebrow}</p>

				<h1 class="hero-title">
					<span class="hero-title__line">Automotive Spare Parts</span>
					<span class="hero-title__line">Supplier in Kuching</span>
				</h1>

				{location ? <p class="hero-location">{location}</p> : null}

				{description ? <p class="hero-desc">{description}</p> : null}

				<div class="hero-actions">
					<MagneticButton href={primaryHref} variant="primary">
						{primaryLabel}
					</MagneticButton>

					<MagneticButton href={whatsappHref} variant="wa" external>
						{whatsappLabel}
					</MagneticButton>
				</div>
			</div>

			<div class="hero-stats" data-animate="stagger-parent">
				{
					stats.map((stat) => (
						<div class="hero-stat">
							<p class="hero-stat__value">{stat.value}</p>
							<p class="hero-stat__label">{stat.label}</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="hero-scroll" aria-hidden="true">
			<div class="flex flex-col items-center gap-2 text-slate-400">
				<span
					class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.2em]"
				>
					Scroll
				</span>

				<svg
					class="h-5 w-5 animate-bounce text-brand-green/70"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M19 9l-7 7-7-7"
					/>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-shell {
		width: 100%;
		max-width: 1480px;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		align-items: start;
		gap: 2.5rem;
	}

	.hero-copy {
		min-width: 0;
	}

	.hero-title {
		margin: 1.1rem 0 0;
		color: rgb(15 23 42);
		font-size: clamp(2.4rem, 8vw, 3.2rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 1.02;
	}

	.hero-title__line {
		display: inline;
	}

	.hero-title__line + .hero-title__line::before {
		content: " ";
	}

	.hero-location {
		margin: 0.45rem 0 0;
		color: rgb(100 116 139);
		font-size: clamp(1.5rem, 4.5vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.08;
	}

	.hero-desc {
		margin: 1.35rem 0 0;
		max-width: 42rem;
		color: rgb(71 85 105);
		font-size: 1rem;
		line-height: 1.65;
		text-align: left;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-top: 1.6rem;
	}

	.hero-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		min-width: 0;
	}

	.hero-stat {
		min-width: 0;
		border: 1px solid rgb(226 232 240);
		border-radius: 0.75rem;
		background: #fff;
		padding: 1rem;
		box-shadow: 0 1px 2px rgb(15 23 42 / 4%);
	}

	.hero-stat__value {
		margin: 0;
		color: var(--color-brand-green);
		font-size: 1.5rem;
		font-weight: 900;
		line-height: 1;
	}

	.hero-stat__label {
		margin: 0.4rem 0 0;
		color: rgb(100 116 139);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero-scroll {
		margin-top: 3.5rem;
		display: flex;
		justify-content: center;
	}

	@media (min-width: 640px) {
		.hero-title {
			font-size: clamp(2.85rem, 6vw, 3.6rem);
			line-height: 1;
		}

		.hero-location {
			font-size: clamp(1.7rem, 3.4vw, 2.25rem);
		}

		.hero-desc {
			font-size: 1.125rem;
		}

		.hero-stat__value {
			font-size: 1.875rem;
		}
	}

	@media (min-width: 768px) {
		.hero-shell {
			padding-inline: 3rem;
		}
	}

	@media (min-width: 1024px) {
		/* Stats stay compact so the H1 keeps enough width for 2 nowrap lines */
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
			gap: 2.5rem 2.75rem;
			align-items: center;
		}

		.hero-title {
			margin-top: 1.15rem;
			max-width: none;
			font-size: clamp(3.35rem, 3.9vw, 4.5rem);
			line-height: 0.96;
		}

		.hero-title__line {
			display: block;
			white-space: nowrap;
		}

		.hero-title__line + .hero-title__line::before {
			content: none;
		}

		.hero-location {
			margin-top: 0.45rem;
			font-size: clamp(1.7rem, 2vw, 2.35rem);
			font-weight: 400;
			line-height: 1.08;
			white-space: nowrap;
		}

		.hero-desc {
			margin-top: 1.25rem;
			max-width: 42rem;
		}

		.hero-actions {
			margin-top: 1.5rem;
		}

		.hero-stats {
			width: 100%;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.75rem;
			align-self: center;
		}

		.hero-stat {
			padding: 1.15rem 0.85rem;
		}

		.hero-stat__value {
			font-size: 1.75rem;
		}

		.hero-scroll {
			margin-top: 3.5rem;
		}
	}

	@media (min-width: 1280px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 2.75rem 3rem;
		}

		.hero-title {
			font-size: clamp(3.75rem, 3.8vw, 4.85rem);
		}

		.hero-location {
			font-size: clamp(1.85rem, 2vw, 2.5rem);
		}

		.hero-stat {
			padding: 1.25rem 1rem;
		}

		.hero-stat__value {
			font-size: 1.9rem;
		}
	}

	@media (max-width: 1023px) {
		.hero-title__line {
			display: inline;
			white-space: normal;
		}

		.hero-title__line + .hero-title__line::before {
			content: " ";
		}

		.hero-location {
			white-space: normal;
		}
	}

	@media (max-width: 639px) {
		.hero-stats {
			grid-template-columns: 1fr;
		}

		.hero-stat {
			padding: 1rem 1.1rem;
		}

		.hero-scroll {
			margin-top: 3rem;
		}
	}
</style>