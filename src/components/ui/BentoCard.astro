---
interface Props {
	span?: string;
	accent?: boolean;
	id?: string;
	class?: string;
	badges?: string[];
}

const { span = "", accent = false, id, class: className = "", badges = [] } = Astro.props;
---

<article
	id={id}
	data-tilt
	class:list={[
		"group relative flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6",
		"transition-[border-color,box-shadow] duration-300",
		"hover:border-slate-300 hover:shadow-md",
		"will-change-transform [transform-style:preserve-3d]",
		accent && "border-emerald-200/80 ring-1 ring-emerald-100",
		span,
		className,
	]}
>
	<div
		class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
		aria-hidden="true"
		style="background: radial-gradient(500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(26, 125, 69, 0.06), transparent 45%);"
	>
	</div>

	{
		badges.length > 0 ? (
			<div class="relative z-10 mb-4 flex flex-wrap items-start justify-between gap-2">
				{badges.map((badge, i) => (
					<span class:list={["th-tech-badge", i === 1 && badges.length > 1 && "ml-auto"]}>{badge}</span>
				))}
			</div>
		) : null
	}

	<div class="relative z-10 flex flex-1 flex-col">
		<slot />
	</div>
</article>
