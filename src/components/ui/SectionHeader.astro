---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	meta?: string;
	class?: string;
	headingId?: string;
}

const { eyebrow, title, description, meta, class: className = "", headingId } = Astro.props;
---

<div class:list={["flex flex-wrap items-end justify-between gap-4", className]} data-animate="fade-up">
	<div class="max-w-2xl">
		<p class="th-tech-badge">{eyebrow}</p>
		<h2 id={headingId} class="mt-4 text-2xl font-bold uppercase tracking-[0.12em] text-slate-900 sm:text-3xl">{title}</h2>
		{description ? <p class="mt-3 text-base leading-relaxed text-slate-600 sm:text-lg">{description}</p> : null}
	</div>
	{meta ? (
		<p class="max-w-sm text-right font-mono text-[10px] leading-relaxed text-slate-500 sm:text-[11px]">
			{meta}
		</p>
	) : null}
</div>
