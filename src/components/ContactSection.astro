---

<section id="contact" class="contact-section scroll-mt-24 border-b border-slate-200 bg-white py-16 md:py-20">
	<div class="th-container">
		<div data-animate="fade-up">
			<p class="th-tech-badge">Contact</p>
			<h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
				Get in touch
			</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
				Visit a branch, call or WhatsApp our team, or email us. Phone, WhatsApp and email are the best ways to reach us for parts and account matters.
			</p>
		</div>

		<div class="contact-branches contact-branches--lead" data-animate="fade-up">
			<div class="branch-list" data-animate="stagger-parent">
				{
					branches.map((b, i) => (
						<article class:list={["branch-panel", i % 2 === 1 && "branch-panel--reverse"]}>
							<div class="branch-panel__map">
								<iframe
									src={b.mapSrc}
									class="branch-panel__iframe"
									allowfullscreen=""
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
									title={b.mapTitle}
								/>
							</div>

							<div class="branch-panel__body">
								<div class="branch-panel__meta">
									<p class="branch-panel__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
									<div>
										<h2 class="branch-panel__heading">{b.heading}</h2>
										<p class="branch-panel__legal">{b.legalName}</p>
									</div>
								</div>

								<address class="branch-panel__address">{b.address}</address>

								<div class="branch-panel__actions">
									<a class="branch-panel__tel" href={`tel:${b.phoneTel}`}>
										<span class="branch-panel__tel-label">Tel</span>
										<span class="branch-panel__tel-value">{b.phone}</span>
									</a>
									<a
										href={waHref(b.waPhone, b.waMessage)}
										target="_blank"
										rel="noopener noreferrer"
										class="th-cta-wa branch-panel__wa"
									>
										WhatsApp Inquiry
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<p class="branch-soon">Coming Soon: 3rd Location in Development</p>
		</div>

		<div class="contact-grid" data-animate="fade-up">
			<div class="contact-form-panel">
				<div class="contact-form-panel__head">
					<h3 class="contact-form-panel__title">Send an email</h3>
					<p class="contact-form-panel__note">
						If the form is not working, or you prefer to write us directly, email{" "}
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
					</p>
				</div>

				<form class="contact-form" id="contact-form" novalidate>
					<div class="contact-form__row">
						<label class="contact-field">
							<span class="contact-field__label">Your name</span>
							<input
								class="contact-field__input"
								type="text"
								name="name"
								autocomplete="name"
								required
								placeholder="Full name"
							/>
						</label>
						<label class="contact-field">
							<span class="contact-field__label">Your email</span>
							<input
								class="contact-field__input"
								type="email"
								name="email"
								autocomplete="email"
								required
								placeholder="you@example.com"
							/>
						</label>
					</div>

					<label class="contact-field">
						<span class="contact-field__label">Subject</span>
						<input
							class="contact-field__input"
							type="text"
							name="subject"
							required
							placeholder="Parts enquiry, account matter, etc."
						/>
					</label>

					<label class="contact-field">
						<span class="contact-field__label">Message</span>
						<textarea
							class="contact-field__input contact-field__textarea"
							name="message"
							required
							rows="5"
							placeholder="Part numbers, vehicle details, or your question…"
						></textarea>
					</label>

					<input type="text" name="website" class="contact-form__honey" tabindex="-1" autocomplete="off" />

					<div class="contact-form__footer">
						<button type="submit" class="contact-form__submit" data-contact-submit>
							Send message
						</button>
						<p class="contact-form__status" data-contact-status hidden></p>
					</div>
				</form>
			</div>

			<aside class="contact-aside">
				<h2 class="contact-aside__title">Telephone, WhatsApp and email</h2>
				<ul class="contact-aside__list">
					<li>
						<span class="contact-aside__label">Email</span>
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					</li>
					<li>
						<span class="contact-aside__label">HQ · Matang Jaya</span>
						<a href="tel:+6082649433">082-649 433</a>
					</li>
					<li>
						<span class="contact-aside__label">Automart · Samarahan</span>
						<a href="tel:+6082375775">082-375 775</a>
					</li>
				</ul>

				<div class="contact-aside__wa">
					<p class="contact-aside__wa-label">WhatsApp by branch</p>
					<div class="contact-aside__wa-links">
						<a href={waHref("60168860864", "Hello Tiong Hock — WhatsApp enquiry for *HQ / Matang Jaya*.\n\nParts / vehicle: ")} target="_blank" rel="noopener noreferrer" class="th-cta-wa contact-aside__wa-btn">
							Matang Jaya
						</a>
						<a href={waHref("60102130132", "Hello Tiong Hock AutoMart — WhatsApp enquiry for *Kota Samarahan*.\n\nParts / vehicle: ")} target="_blank" rel="noopener noreferrer" class="th-cta-wa contact-aside__wa-btn">
							Samarahan
						</a>
					</div>
				</div>
			</aside>
		</div>

		<div class="contact-facebook" data-animate="fade-up">
			<div class="contact-facebook__row">
				<div class="contact-facebook__lead">
					<span class="contact-facebook__icon" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
							<path
								d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
							></path>
						</svg>
					</span>
					<div>
						<p class="contact-facebook__label">Official Facebook</p>
						<p class="contact-facebook__text">
							Follow us for company updates, announcements and scam alerts.
						</p>
					</div>
				</div>
				<a
					class="contact-facebook__link"
					href={facebookUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Visit Tiong Hock Auto Parts official Facebook page (opens in a new tab)"
				>
					Visit our Facebook page <span aria-hidden="true">→</span>
				</a>
			</div>
			<p class="contact-facebook__warning" role="note">
				We do not accept orders or payments through Facebook.
			</p>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const statusEl = document.querySelector<HTMLParagraphElement>("[data-contact-status]");
	const submitBtn = document.querySelector<HTMLButtonElement>("[data-contact-submit]");

	if (form && statusEl && submitBtn) {
		const setStatus = (message: string, type: "success" | "error" | "") => {
			if (!message) {
				statusEl.hidden = true;
				statusEl.textContent = "";
				statusEl.classList.remove("is-success", "is-error");
				return;
			}
			statusEl.hidden = false;
			statusEl.textContent = message;
			statusEl.classList.toggle("is-success", type === "success");
			statusEl.classList.toggle("is-error", type === "error");
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = "Sending…";
			setStatus("", "");

			try {
				const data = Object.fromEntries(new FormData(form).entries());
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: {
						Accept: "application/json",
						"Content-Type": "application/json",
					},
					credentials: "same-origin",
					body: JSON.stringify({
						name: String(data.name ?? ""),
						email: String(data.email ?? ""),
						subject: String(data.subject ?? ""),
						message: String(data.message ?? ""),
						website: String(data.website ?? ""),
					}),
				});

				const raw = await response.text();
				let result: { ok?: boolean; error?: string } = {};
				try {
					result = raw ? (JSON.parse(raw) as { ok?: boolean; error?: string }) : {};
				} catch {
					result = {};
				}

				if (!response.ok || !result.ok) {
					const fallback =
						response.status >= 500
							? "Could not send right now. Please email enquiries@tionghock.com.my directly."
							: "Send failed";
					throw new Error(result.error || fallback);
				}

				form.reset();
				setStatus("Message sent. Our team will reply to your email.", "success");
			} catch (err) {
				const message =
					err instanceof Error
						? err.message
						: "Could not send right now. Please email enquiries@tionghock.com.my directly.";
				setStatus(message, "error");
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = "Send message";
			}
		});
	}
</script>

<style>
