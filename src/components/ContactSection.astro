---
import DistributionMap from "./DistributionMap.astro";

const CONTACT_EMAIL = "accounts@tionghock.com";

const waHref = (waPhone: string, message: string) =>
	`https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`;

const branches = [
	{
		heading: "HQ · Matang Jaya",
		legalName: "Tiong Hock Auto Parts (Kch) Sdn Bhd",
		address: "Sublot 37, Phase 12, Jln Matang Jaya, Taman Lee Ling, 93050 Kuching",
		phone: "082-649 433",
		phoneTel: "+6082649433",
		waPhone: "60168860864",
		waMessage:
			"Hello Tiong Hock Auto Parts (Kch) Sdn Bhd — WhatsApp enquiry for *HQ / Matang Jaya*.\n\nParts / vehicle: ",
		mapSrc:
			"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5291.791400552243!2d110.30063600000001!3d1.571454!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31fb07dbb4144f5d%3A0xbaa60fc8c64e909c!2sTiong%20Hock%20Auto%20Parts(Kch)Sdn%20Bhd!5e1!3m2!1sen!2smy!4v1788319114904!5m2!1sen!2smy",
		mapTitle: "Tiong Hock Auto Parts (Kch) Sdn Bhd — Matang Jaya HQ on Google Maps",
	},
	{
		heading: "Automart · Kota Samarahan",
		legalName: "Tiong Hock AutoMart Sdn Bhd",
		address: "Uni Central Commercial Centre, Lot 27, Ground Floor, 94300 Kota Samarahan",
		phone: "082-375 775",
		phoneTel: "+6082375775",
		waPhone: "60102130132",
		waMessage:
			"Hello Tiong Hock AutoMart — WhatsApp enquiry for *Uni Central, Kota Samarahan*.\n\nParts / vehicle: ",
		mapSrc:
			"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5292.034849398899!2d110.4163807!3d1.4722414000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31fba1d890fc5809%3A0x7e8731e341b640aa!2sTiong%20Hock%20AutoMart%20Sdn%20Bhd!5e1!3m2!1sen!2smy!4v1788319632228!5m2!1sen!2smy",
		mapTitle: "Tiong Hock AutoMart Sdn Bhd — Kota Samarahan on Google Maps",
	},
];
---

<section id="contact" class="contact-section scroll-mt-24 border-b border-slate-200 bg-white py-16 md:py-20">
	<div class="th-container">
		<div data-animate="fade-up">
			<p class="th-tech-badge">Contact</p>
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
				Get in touch
			</h2>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
				Email our team, call a branch, or visit Matang Jaya HQ and Kota Samarahan Automart in person.
			</p>
		</div>

		<div class="contact-grid" data-animate="fade-up">
			<div class="contact-form-panel">
				<div class="contact-form-panel__head">
					<h3 class="contact-form-panel__title">Send an email</h3>
					<p class="contact-form-panel__to">
						Messages go to{" "}
						<a href={`mailto:${CONTACT_EMAIL}`} class="contact-form-panel__email">{CONTACT_EMAIL}</a>
					</p>
				</div>

				<form class="contact-form" id="contact-form" novalidate>
					<div class="contact-form__row">
						<label class="contact-field">
							<span class="contact-field__label">Your name</span>
							<input
								class="contact-field__input"
								type="text"
								name="name"
								autocomplete="name"
								required
								placeholder="Full name"
							/>
						</label>
						<label class="contact-field">
							<span class="contact-field__label">Your email</span>
							<input
								class="contact-field__input"
								type="email"
								name="email"
								autocomplete="email"
								required
								placeholder="you@example.com"
							/>
						</label>
					</div>

					<label class="contact-field">
						<span class="contact-field__label">Subject</span>
						<input
							class="contact-field__input"
							type="text"
							name="_subject"
							required
							placeholder="Parts enquiry, account matter, etc."
						/>
					</label>

					<label class="contact-field">
						<span class="contact-field__label">Message</span>
						<textarea
							class="contact-field__input contact-field__textarea"
							name="message"
							required
							rows="5"
							placeholder="Part numbers, vehicle details, or your question…"
						></textarea>
					</label>

					<input type="text" name="_honey" class="contact-form__honey" tabindex="-1" autocomplete="off" />

					<div class="contact-form__footer">
						<button type="submit" class="contact-form__submit" data-contact-submit>
							Send message
						</button>
						<p class="contact-form__status" data-contact-status hidden></p>
					</div>
				</form>
			</div>

			<aside class="contact-aside">
				<h3 class="contact-aside__title">Direct lines</h3>
				<ul class="contact-aside__list">
					<li>
						<span class="contact-aside__label">Email</span>
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					</li>
					<li>
						<span class="contact-aside__label">HQ · Matang Jaya</span>
						<a href="tel:+6082649433">082-649 433</a>
					</li>
					<li>
						<span class="contact-aside__label">Automart · Samarahan</span>
						<a href="tel:+6082375775">082-375 775</a>
					</li>
					<li>
						<span class="contact-aside__label">HQ fax</span>
						<span>082-649 488</span>
					</li>
				</ul>

				<div class="contact-aside__wa">
					<p class="contact-aside__wa-label">WhatsApp by branch</p>
					<div class="contact-aside__wa-links">
						<a href={waHref("60168860864", "Hello Tiong Hock — WhatsApp enquiry for *HQ / Matang Jaya*.\n\nParts / vehicle: ")} target="_blank" rel="noopener noreferrer" class="th-cta-wa contact-aside__wa-btn">
							Matang Jaya
						</a>
						<a href={waHref("60102130132", "Hello Tiong Hock AutoMart — WhatsApp enquiry for *Kota Samarahan*.\n\nParts / vehicle: ")} target="_blank" rel="noopener noreferrer" class="th-cta-wa contact-aside__wa-btn">
							Samarahan
						</a>
					</div>
				</div>
			</aside>
		</div>

		<DistributionMap variant="compact" />

		<div class="contact-branches" data-animate="fade-up">
			<div class="branch-list" data-animate="stagger-parent">
				{
					branches.map((b, i) => (
						<article class:list={["branch-panel", i % 2 === 1 && "branch-panel--reverse"]}>
							<div class="branch-panel__map">
								<iframe
									src={b.mapSrc}
									class="branch-panel__iframe"
									allowfullscreen=""
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
									title={b.mapTitle}
								/>
							</div>

							<div class="branch-panel__body">
								<div class="branch-panel__meta">
									<p class="branch-panel__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
									<div>
										<h4 class="branch-panel__heading">{b.heading}</h4>
										<p class="branch-panel__legal">{b.legalName}</p>
									</div>
								</div>

								<address class="branch-panel__address">{b.address}</address>

								<div class="branch-panel__actions">
									<a class="branch-panel__tel" href={`tel:${b.phoneTel}`}>
										<span class="branch-panel__tel-label">Tel</span>
										<span class="branch-panel__tel-value">{b.phone}</span>
									</a>
									<a
										href={waHref(b.waPhone, b.waMessage)}
										target="_blank"
										rel="noopener noreferrer"
										class="th-cta-wa branch-panel__wa"
									>
										WhatsApp Inquiry
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<p class="branch-soon">Coming Soon: 3rd Location in Development</p>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const statusEl = document.querySelector<HTMLParagraphElement>("[data-contact-status]");
	const submitBtn = document.querySelector<HTMLButtonElement>("[data-contact-submit]");
	const CONTACT_EMAIL = "accounts@tionghock.com";

	if (form && statusEl && submitBtn) {
		const setStatus = (message: string, type: "success" | "error" | "") => {
			if (!message) {
				statusEl.hidden = true;
				statusEl.textContent = "";
				statusEl.classList.remove("is-success", "is-error");
				return;
			}
			statusEl.hidden = false;
			statusEl.textContent = message;
			statusEl.classList.toggle("is-success", type === "success");
			statusEl.classList.toggle("is-error", type === "error");
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const formData = new FormData(form);
			formData.append("_captcha", "false");
			formData.append("_template", "table");

			const userEmail = String(formData.get("email") ?? "");
			if (userEmail) formData.append("_replyto", userEmail);

			submitBtn.disabled = true;
			submitBtn.textContent = "Sending…";
			setStatus("", "");

			try {
				const response = await fetch(`https://formsubmit.co/ajax/${CONTACT_EMAIL}`, {
					method: "POST",
					headers: { Accept: "application/json" },
					body: formData,
				});

				const result = (await response.json()) as { success?: string | boolean; message?: string };
				const ok = result.success === true || result.success === "true";

				if (!response.ok || !ok) {
					const activationNeeded = result.message?.toLowerCase().includes("activation");
					if (activationNeeded) {
						setStatus(
							"Email delivery is being set up. For now, please email us directly at accounts@tionghock.com.",
							"error",
						);
						return;
					}
					throw new Error(result.message ?? "Send failed");
				}

				form.reset();
				setStatus("Message sent. Our team will reply to your email.", "success");
			} catch {
				setStatus("Could not send right now. Please email us directly at accounts@tionghock.com.", "error");
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = "Send message";
			}
		});
	}
</script>

<style>
	.contact-grid {
		margin-top: 2.5rem;
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 1024px) {
		.contact-grid {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
			gap: 1.5rem;
			align-items: start;
		}
	}

	.contact-form-panel,
	.contact-aside {
		border: 1px solid #e2e8f0;
		background: #fff;
	}

	.contact-form-panel {
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.contact-form-panel {
			padding: 2rem;
		}
	}

	.contact-form-panel__head {
		margin-bottom: 1.5rem;
	}

	.contact-form-panel__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: #0f172a;
	}

	.contact-form-panel__to {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		color: #64748b;
	}

	.contact-form-panel__email {
		font-weight: 600;
		color: var(--color-brand-green);
		text-decoration: none;
	}

	.contact-form-panel__email:hover {
		text-decoration: underline;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-form__row {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.contact-form__row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.contact-field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.contact-field__label {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #64748b;
	}

	.contact-field__input {
		width: 100%;
		border: 1px solid #cbd5e1;
		background: #f8fafc;
		padding: 0.7rem 0.85rem;
		font-size: 0.9rem;
		color: #0f172a;
		transition: border-color 0.15s, background-color 0.15s;
	}

	.contact-field__input::placeholder {
		color: #94a3b8;
	}

	.contact-field__input:focus {
		outline: 2px solid color-mix(in oklab, var(--color-brand-green) 35%, transparent);
		outline-offset: 0;
		border-color: var(--color-brand-green);
		background: #fff;
	}

	.contact-field__textarea {
		resize: vertical;
		min-height: 8rem;
	}

	.contact-form__honey {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.contact-form__footer {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 0.25rem;
	}

	.contact-form__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		min-width: 10rem;
		border: 0;
		background: var(--color-brand-green);
		padding: 0.75rem 1.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: #fff;
		cursor: pointer;
		transition: background-color 0.15s;
	}

	.contact-form__submit:hover:not(:disabled) {
		background: color-mix(in oklab, var(--color-brand-green) 88%, black);
	}

	.contact-form__submit:disabled {
		opacity: 0.7;
		cursor: wait;
	}

	.contact-form__status {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.contact-form__status.is-success {
		color: var(--color-brand-green);
	}

	.contact-form__status.is-error {
		color: #b91c1c;
	}

	.contact-aside {
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.contact-aside {
			padding: 2rem;
		}
	}

	.contact-aside__title {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #64748b;
	}

	.contact-aside__list {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-aside__list li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 0.9rem;
		color: #0f172a;
	}

	.contact-aside__label {
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #94a3b8;
	}

	.contact-aside__list a {
		font-weight: 600;
		color: #0f172a;
		text-decoration: none;
	}

	.contact-aside__list a:hover {
		color: var(--color-brand-green);
	}

	.contact-aside__wa {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid #e2e8f0;
	}

	.contact-aside__wa-label {
		margin: 0;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #94a3b8;
	}

	.contact-aside__wa-links {
		margin-top: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contact-aside__wa-btn {
		justify-content: center;
	}

	.contact-branches {
		margin-top: 2.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid #e2e8f0;
	}

	.branch-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.branch-panel {
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		border: 1px solid #e2e8f0;
		background: #fff;
	}

	.branch-panel__map {
		min-height: 14rem;
		background: #f1f5f9;
	}

	.branch-panel__iframe {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 14rem;
		border: 0;
	}

	.branch-panel__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.25rem;
		padding: 1.5rem;
	}

	.branch-panel__meta {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.branch-panel__index {
		margin: 0;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: #94a3b8;
		line-height: 1.4;
	}

	.branch-panel__heading {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-brand-green);
	}

	.branch-panel__legal {
		margin: 0.35rem 0 0;
		font-size: 0.75rem;
		font-weight: 500;
		color: #64748b;
	}

	.branch-panel__address {
		margin: 0;
		font-style: normal;
		font-size: 0.9rem;
		line-height: 1.65;
		color: #475569;
	}

	.branch-panel__actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.branch-panel__tel {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		width: fit-content;
		text-decoration: none;
	}

	.branch-panel__tel-label {
		font-size: 0.8rem;
		color: #64748b;
	}

	.branch-panel__tel-value {
		font-size: 0.95rem;
		font-weight: 600;
		color: #0f172a;
	}

	.branch-panel__tel:hover .branch-panel__tel-value {
		color: var(--color-brand-green);
	}

	.branch-panel__wa {
		width: 100%;
	}

	.branch-soon {
		margin: 1.25rem 0 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid #e2e8f0;
		background: #f8fafc;
		padding: 0.625rem 1rem;
		text-align: center;
		font-family: ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #64748b;
	}

	@media (min-width: 768px) {
		.branch-list {
			gap: 1.5rem;
		}

		.branch-panel {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			min-height: 18rem;
		}

		.branch-panel--reverse {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		}

		.branch-panel--reverse .branch-panel__map {
			order: 2;
		}

		.branch-panel--reverse .branch-panel__body {
			order: 1;
		}

		.branch-panel__map,
		.branch-panel__iframe {
			min-height: 18rem;
		}

		.branch-panel__body {
			padding: 2rem 2.25rem;
		}

		.branch-panel__wa {
			width: auto;
			align-self: flex-start;
		}
	}

	@media (min-width: 1024px) {
		.branch-panel__body {
			padding: 2.5rem 2.75rem;
		}
	}
</style>
