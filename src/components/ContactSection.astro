const waHref = (waPhone: string, message: string) =>
	`https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`;

const branches = [
	{
		heading: "HQ · Matang Jaya",
		legalName: "Tiong Hock Auto Parts (Kch) Sdn Bhd",
		address:
			"Lot 9747, Section 65, Sublot 37, Phase 12, Jalan Matang Jaya, Taman Lee Ling, 93050 Kuching, Sarawak",
		phone: "082-649 433",
		phoneTel: "+6082649433",
		waPhone: "60168860864",
		waMessage:
			"Hello Tiong Hock Auto Parts (Kch) Sdn Bhd — WhatsApp enquiry for *HQ / Matang Jaya*.\n\nParts / vehicle: ",
		mapSrc:
			"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5291.791400552243!2d110.30063600000001!3d1.571454!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31fb07dbb4144f5d%3A0xbaa60fc8c64e909c!2sTiong%20Hock%20Auto%20Parts(Kch)Sdn%20Bhd!5e1!3m2!1sen!2smy!4v1788319114904!5m2!1sen!2smy",
		mapTitle: "Tiong Hock Auto Parts (Kch) Sdn Bhd — Matang Jaya HQ on Google Maps",
	},
	{
		heading: "Automart · Kota Samarahan",
		legalName: "Tiong Hock AutoMart Sdn Bhd",
		address: "Uni Central Commercial Centre, Lot 27, Ground Floor, 94300 Kota Samarahan",
		phone: "082-375 775",
		phoneTel: "+6082375775",
		waPhone: "60102130132",
		waMessage:
			"Hello Tiong Hock AutoMart — WhatsApp enquiry for *Uni Central, Kota Samarahan*.\n\nParts / vehicle: ",
		mapSrc:
			"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5292.034849398899!2d110.4163807!3d1.4722414000000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31fba1d890fc5809%3A0x7e8731e341b640aa!2sTiong%20Hock%20AutoMart%20Sdn%20Bhd!5e1!3m2!1sen!2smy!4v1788319632228!5m2!1sen!2smy",
		mapTitle: "Tiong Hock AutoMart Sdn Bhd — Kota Samarahan on Google Maps",
	},
