---
const CAREERS_EMAIL = "careers@tionghock.com.my";

const roles = [
	"Warehouse / Store Assistant",
	"Counter Sales",
	"Driver / Delivery",
	"Accounts / Admin",
	"Technical Support",
	"Other",
];
---

<section id="careers" class="careers-section scroll-mt-24 border-b border-slate-200 bg-white py-16 md:py-20">
	<div class="th-container">
		<div data-animate="fade-up">
			<p class="th-tech-badge">Careers</p>
			<h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
				Join the Tiong Hock team
			</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
				We are always looking for reliable people for warehouse, counter sales, delivery, and office roles
				across Matang Jaya and Kota Samarahan. Fill in the form and optionally upload your resume or a photo —
				we will contact you if there is a fit.
			</p>
		</div>

		<div class="careers-grid" data-animate="fade-up">
			<div class="careers-panel">
				<div class="careers-panel__head">
					<h2 class="careers-panel__title">Application form</h2>
					<p class="careers-panel__note">
						If the form is not working, or you prefer to write us directly, email{" "}
						<a href={`mailto:${CAREERS_EMAIL}`}>{CAREERS_EMAIL}</a>.
					</p>
				</div>

				<form class="careers-form" id="careers-form" enctype="multipart/form-data" novalidate>
					<div class="careers-form__row">
						<label class="careers-field">
							<span class="careers-field__label">Full name</span>
							<input
								class="careers-field__input"
								type="text"
								name="name"
								autocomplete="name"
								required
								placeholder="Your full name"
							/>
						</label>
						<label class="careers-field">
							<span class="careers-field__label">Email</span>
							<input
								class="careers-field__input"
								type="email"
								name="email"
								autocomplete="email"
								required
								placeholder="you@example.com"
							/>
						</label>
					</div>

					<div class="careers-form__row">
						<label class="careers-field">
							<span class="careers-field__label">Phone</span>
							<input
								class="careers-field__input"
								type="tel"
								name="phone"
								autocomplete="tel"
								required
								placeholder="01X-XXX XXXX"
							/>
						</label>
						<label class="careers-field">
							<span class="careers-field__label">Preferred location</span>
							<select class="careers-field__input" name="location" required>
								<option value="" disabled selected>Select a branch</option>
								<option value="Matang Jaya HQ">Matang Jaya HQ</option>
								<option value="Kota Samarahan Automart">Kota Samarahan Automart</option>
								<option value="Either / Flexible">Either / Flexible</option>
							</select>
						</label>
					</div>

					<label class="careers-field">
						<span class="careers-field__label">Position interested in</span>
						<select class="careers-field__input" name="position" required>
							<option value="" disabled selected>Select a role</option>
							{roles.map((role) => <option value={role}>{role}</option>)}
						</select>
					</label>

					<label class="careers-field">
						<span class="careers-field__label">About you</span>
						<textarea
							class="careers-field__input careers-field__textarea"
							name="message"
							required
							rows="5"
							placeholder="Briefly introduce yourself, experience, and availability…"
						></textarea>
					</label>

					<label class="careers-field">
						<span class="careers-field__label">Resume / photo (optional)</span>
						<input
							class="careers-field__file"
							type="file"
							name="attachment"
							accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"
							data-careers-resume
						/>
						<span class="careers-field__hint">PDF, DOC, DOCX, JPG, PNG, or WEBP · max 5 MB</span>
						<span class="careers-field__file-name" data-careers-file-name hidden></span>
					</label>

					<input type="text" name="website" class="careers-form__honey" tabindex="-1" autocomplete="off" />

					<div class="careers-form__footer">
						<button type="submit" class="careers-form__submit" data-careers-submit>
							Submit application
						</button>
						<p class="careers-form__status" data-careers-status hidden></p>
					</div>
				</form>
			</div>

			<aside class="careers-aside">
				<h2 class="careers-aside__title">What we look for</h2>
				<ul class="careers-aside__list">
					<li>Honest, reliable, and willing to learn</li>
					<li>Comfortable with warehouse or counter pace</li>
					<li>Basic Bahasa Malaysia / English communication</li>
					<li>Own transport preferred for some roles</li>
				</ul>

				<p class="careers-aside__legal">
					By submitting, you agree that Tiong Hock Auto Parts (KCH) Sdn Bhd may contact you about this
					application. We keep applications for recruitment only.
				</p>
			</aside>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("careers-form") as HTMLFormElement | null;
	const statusEl = document.querySelector<HTMLParagraphElement>("[data-careers-status]");
	const submitBtn = document.querySelector<HTMLButtonElement>("[data-careers-submit]");
	const resumeInput = document.querySelector<HTMLInputElement>("[data-careers-resume]");
	const fileNameEl = document.querySelector<HTMLElement>("[data-careers-file-name]");
	const MAX_BYTES = 5 * 1024 * 1024;
	const ALLOWED_EXT = new Set(["pdf", "doc", "docx", "jpg", "jpeg", "png", "webp"]);

	const setStatus = (message: string, type: "success" | "error" | "") => {
		if (!statusEl) return;
		if (!message) {
			statusEl.hidden = true;
			statusEl.textContent = "";
			statusEl.classList.remove("is-success", "is-error");
			return;
		}
		statusEl.hidden = false;
		statusEl.textContent = message;
		statusEl.classList.toggle("is-success", type === "success");
		statusEl.classList.toggle("is-error", type === "error");
	};

	const validateFile = (file: File): string | null => {
		const ext = file.name.split(".").pop()?.toLowerCase() ?? "";
		if (!ALLOWED_EXT.has(ext)) return "File must be PDF, DOC, DOCX, JPG, PNG, or WEBP.";
		if (file.size > MAX_BYTES) return "File must be 5 MB or smaller.";
		return null;
	};

	if (resumeInput && fileNameEl) {
		resumeInput.addEventListener("change", () => {
			const file = resumeInput.files?.[0] ?? null;
			if (!file) {
				fileNameEl.hidden = true;
				fileNameEl.textContent = "";
				fileNameEl.classList.remove("is-error");
				return;
			}
			const error = validateFile(file);
			fileNameEl.hidden = false;
			fileNameEl.textContent = error ? error : `Selected: ${file.name}`;
			fileNameEl.classList.toggle("is-error", Boolean(error));
		});
	}

	if (form && submitBtn) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}

			const file = resumeInput?.files?.[0] ?? null;
			if (file) {
				const error = validateFile(file);
				if (error) {
					setStatus(error, "error");
					return;
				}
			}

			submitBtn.disabled = true;
			submitBtn.textContent = "Submitting…";
			setStatus("", "");

			try {
				const formData = new FormData(form);
				/** @type {Record<string, unknown>} */
				const payload = {
					name: formData.get("name"),
					email: formData.get("email"),
					phone: formData.get("phone"),
					location: formData.get("location"),
					position: formData.get("position"),
					message: formData.get("message"),
					website: formData.get("website"),
				};

				if (file) {
					const bytes = new Uint8Array(await file.arrayBuffer());
					const chunk = 0x8000;
					let binary = "";
					for (let i = 0; i < bytes.length; i += chunk) {
						binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
					}
					payload.attachment = {
						filename: file.name,
						contentType: file.type || "application/octet-stream",
						content: btoa(binary),
					};
				}

				const response = await fetch("/api/careers", {
					method: "POST",
					headers: {
						Accept: "application/json",
						"Content-Type": "application/json",
					},
					body: JSON.stringify(payload),
				});

				const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

				if (!response.ok || !result.ok) {
					throw new Error(result.error || "Submit failed");
				}

				form.reset();
				if (fileNameEl) {
					fileNameEl.hidden = true;
					fileNameEl.textContent = "";
					fileNameEl.classList.remove("is-error");
				}
				setStatus("Application received. Our team will contact you if there is a suitable opening.", "success");
			} catch (err) {
				const message = err instanceof Error ? err.message : "Could not submit right now. Please try again later.";
				setStatus(message, "error");
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = "Submit application";
			}
		});
	}
</script>

<style>
	.careers-grid {
		margin-top: 2.5rem;
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 1024px) {
		.careers-grid {
			grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
			gap: 1.5rem;
			align-items: start;
		}
	}

	.careers-panel,
	.careers-aside {
		border: 1px solid #e2e8f0;
		background: #fff;
	}

	.careers-panel {
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.careers-panel {
			padding: 2rem;
		}
	}

	.careers-panel__head {
		margin-bottom: 1.25rem;
	}

	.careers-panel__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: #0f172a;
	}

	.careers-panel__note {
		margin: 0.5rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: #64748b;
	}

	.careers-panel__note a {
		color: var(--color-brand, #003820);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.careers-panel__note a:hover {
		color: var(--color-brand-lime, #98d030);
	}

	.careers-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: relative;
	}

	.careers-form__row {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.careers-form__row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.careers-field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.careers-field__label {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #64748b;
	}

	.careers-field__input,
	.careers-field__file {
		width: 100%;
		border: 1px solid #cbd5e1;
		background: #f8fafc;
		padding: 0.7rem 0.85rem;
		font-size: 0.9rem;
		color: #0f172a;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}

	.careers-field__input::placeholder {
		color: #94a3b8;
	}

	.careers-field__input:focus,
	.careers-field__file:focus {
		outline: 2px solid color-mix(in oklab, var(--color-brand-green) 35%, transparent);
		outline-offset: 0;
		border-color: var(--color-brand-green);
		background: #fff;
	}

	.careers-field__textarea {
		resize: vertical;
		min-height: 8rem;
	}

	.careers-field__hint {
		font-size: 0.75rem;
		color: #94a3b8;
	}

	.careers-field__file-name {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-brand);
	}

	.careers-field__file-name.is-error {
		color: #b91c1c;
	}

	.careers-form__honey {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.careers-form__footer {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 0.25rem;
	}

	.careers-form__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		min-width: 11rem;
		border: 0;
		background: var(--color-brand);
		padding: 0.75rem 1.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: #fff;
		cursor: pointer;
		transition: background-color 0.15s;
	}

	.careers-form__submit:hover:not(:disabled) {
		background: color-mix(in oklab, var(--color-brand) 88%, black);
	}

	.careers-form__submit:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.careers-form__status {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.careers-form__status.is-success {
		color: var(--color-brand);
	}

	.careers-form__status.is-error {
		color: #b91c1c;
	}

	.careers-aside {
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.careers-aside {
			padding: 1.75rem;
		}
	}

	.careers-aside__title {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #64748b;
	}

	.careers-aside__list {
		margin: 1rem 0 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.55rem;
		color: #334155;
		font-size: 0.9rem;
		line-height: 1.45;
	}

	.careers-aside__legal {
		margin: 1.5rem 0 0;
		border-top: 1px solid #e2e8f0;
		padding-top: 1.15rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: #94a3b8;
	}
</style>
