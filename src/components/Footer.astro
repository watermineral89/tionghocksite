---
import { FACEBOOK_PAGE_URL } from "../data/social-links";
import ResponsiveRaster from "./ResponsiveRaster.astro";

const year = new Date().getFullYear();
const facebookUrl = FACEBOOK_PAGE_URL;

const quickLinks = [
	{ href: "/parts", label: "Parts & Stock Search" },
	{ href: "/parts#parts-categories", label: "Parts Categories" },
	{ href: "/about#about", label: "About Us" },
	{ href: "/about#capabilities", label: "Capabilities" },
	{ href: "/careers", label: "Careers" },
	{ href: "/contact", label: "Contact" },
];
---

<footer class="th-footer border-t border-slate-200 bg-slate-50">
	<div class="th-container th-footer__inner">
		<div class="th-footer__grid">
			<div class="th-footer__brand">
				<a
					href="/"
					class="th-footer__brand-link outline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
				>
					<ResponsiveRaster
						base="/logo-mark"
						widths={[96, 192, 288]}
						fallbackSrc="/logo-mark-192w.webp"
						alt="Tiong Hock Auto Parts"
						width={96}
						height={97}
						sizes="6rem"
						class="th-footer__logo"
						loading="lazy"
					/>
					<p class="th-footer__company">TIONG HOCK AUTO PARTS (KCH) SDN BHD</p>
				</a>
				<p class="th-footer__desc">
					Wholesale &amp; retail sale of motor vehicle spare parts &amp; accessories.
				</p>
				<p class="th-footer__location">MATANG · SAMARAHAN</p>
				<ul class="th-footer__social" aria-label="Social media">
					<li>
						<a
							class="th-footer__social-link"
							href={facebookUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Tiong Hock Auto Parts on Facebook (opens in a new tab)"
						>
							<span class="th-footer__social-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
									<path
										d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
									></path>
								</svg>
							</span>
							Facebook
						</a>
					</li>
				</ul>
			</div>

			<div class="th-footer__col">
				<h3 class="th-footer__heading">Direct contacts</h3>
				<ul class="th-footer__list text-sm text-slate-600">
					<li class="th-footer__contact-block">
						<span class="th-footer__contact-label">Matang Jaya HQ</span>
						<span class="th-footer__phone">
							<span class="th-footer__phone-text">082-649 433</span>
							<a class="th-footer__phone-link" href="tel:+6082649433">082-649 433</a>
						</span>
					</li>
					<li class="th-footer__contact-block">
						<span class="th-footer__contact-label">Kota Samarahan Automart</span>
						<span class="th-footer__phone">
							<span class="th-footer__phone-text">082-375 775</span>
							<a class="th-footer__phone-link" href="tel:+6082375775">082-375 775</a>
						</span>
					</li>
					<li class="th-footer__contact-block">
						<span class="th-footer__contact-label">Email</span>
						<a class="th-footer__contact-value" href="mailto:enquiries@tionghock.com.my">enquiries@tionghock.com.my</a>
					</li>
				</ul>
			</div>

			<div class="th-footer__col">
				<h3 class="th-footer__heading">Quick links</h3>
				<ul class="th-footer__list text-sm">
					{
						quickLinks.map((link) => (
							<li>
								<a class="text-slate-600 transition hover:text-brand-green" href={link.href}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<p class="th-footer__legal">
			© {year} TIONG HOCK AUTO PARTS (KCH) SDN BHD · REG. NO. 201301042376 (1072201-H) · DESIGNED &amp; DEVELOPED IN-HOUSE
		</p>
	</div>
</footer>

<style>
	.th-footer__inner {
		padding-block: 2.75rem;
	}

	.th-footer__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.25rem;
		align-items: start;
	}

	.th-footer__brand-link {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.65rem;
		text-decoration: none;
	}

	.th-footer__logo {
		display: block;
		width: 5.25rem;
		height: auto;
		object-fit: contain;
	}

	.th-footer__company {
		margin: 0;
		max-width: 100%;
		color: var(--color-brand);
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.th-footer__desc {
		margin: 0.65rem 0 0;
		max-width: 21rem;
		color: rgb(71 85 105);
		font-size: 0.875rem;
		line-height: 1.55;
	}

	.th-footer__location {
		margin: 0.55rem 0 0;
		color: rgb(71 85 105);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.th-footer__social {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.th-footer__social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: rgb(71 85 105);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.th-footer__social-link:hover {
		color: var(--color-brand);
	}

	.th-footer__social-icon {
		display: inline-flex;
		color: #1877f2;
	}

	.th-footer__heading {
		margin: 0;
		color: rgb(71 85 105);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.th-footer__list {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.95rem;
	}

	.th-footer__contact-block {
		display: grid;
		gap: 0.15rem;
	}

	.th-footer__contact-label {
		color: rgb(71 85 105);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.th-footer__contact-value {
		color: rgb(15 23 42);
		text-decoration: none;
	}

	.th-footer__contact-value:hover {
		text-decoration: underline;
	}

	.th-footer__contact-value--muted {
		color: rgb(71 85 105);
	}

	/* Landlines: plain text on desktop, tap-to-call on mobile only */
	.th-footer__phone {
		color: rgb(15 23 42);
	}

	.th-footer__phone-link {
		display: none;
		color: inherit;
		text-decoration: none;
	}

	.th-footer__phone-text {
		display: inline;
	}

	@media (max-width: 768px) {
		.th-footer__phone-text {
			display: none;
		}

		.th-footer__phone-link {
			display: inline;
		}
	}

	.th-footer__legal {
		margin: 2rem 0 0;
		border-top: 1px solid rgb(226 232 240);
		padding-top: 1.15rem;
		text-align: center;
		color: rgb(71 85 105);
		font-size: 0.6875rem;
		line-height: 1.55;
	}

	@media (min-width: 769px) {
		.th-footer__inner {
			padding-block: 3rem;
		}

		.th-footer__grid {
			grid-template-columns: minmax(430px, 1.5fr) 1fr 1fr;
			gap: 4rem;
			align-items: start;
		}

		.th-footer__col {
			align-self: center;
			transform: translateY(-0.75rem);
		}

		.th-footer__logo {
			width: 6rem;
		}

		.th-footer__company {
			white-space: nowrap;
			font-size: 1.0625rem;
		}

		.th-footer__legal {
			margin-top: 2.25rem;
			padding-top: 1.25rem;
			font-size: 0.75rem;
		}
	}

	@media (min-width: 769px) and (max-width: 1100px) {
		.th-footer__grid {
			gap: 2.75rem;
			grid-template-columns: minmax(380px, 1.45fr) 1fr 1fr;
		}

		.th-footer__company {
			font-size: 0.9375rem;
		}

		.th-footer__logo {
			width: 5.5rem;
		}
	}

	@media (max-width: 768px) {
		.th-footer__company {
			white-space: normal;
		}
	}
</style>
