---
const items = [
	{
		title: "Genuine & OEM-equivalent",
		body: "Traceable sourcing with batch consistency for high-wear assemblies and service-critical kits.",
	},
	{
		title: "Technical ID support",
		body: "VIN, chassis, and application cross-checks so the right component lands the first time.",
	},
	{
		title: "Fleet programmes",
		body: "Contract pricing, consolidated invoicing, and scheduled releases aligned to PM intervals.",
	},
	{
		title: "Workshop throughput",
		body: "Pick-face ready cartons, minimal repack friction, and predictable lead times on core movers.",
	},
];
---

<section id="capabilities" class="scroll-mt-24 border-b border-zinc-200 bg-white">
	<div class="th-container py-16 lg:py-20">
		<div class="max-w-2xl">
			<p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand">Capabilities</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl">Built like industrial OEM support.</h2>
			<p class="mt-4 text-lg text-zinc-700">
				From urban distribution to long-haul linehaul, we structure supply the way serious operators run maintenance:
				predictable, documented, and fast.
			</p>
		</div>
		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{
				items.map((item) => (
					<article class="border border-zinc-200 bg-white p-6">
						<h3 class="text-lg font-semibold text-zinc-900">{item.title}</h3>
						<p class="mt-3 text-justify text-sm leading-relaxed text-zinc-700">{item.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
