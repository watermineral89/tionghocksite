---
import SectionHeader from "../ui/SectionHeader.astro";
import { galleryPhotos } from "../../data/gallery.ts";
---

<section id="gallery" class="scroll-mt-24 th-section-alt" aria-labelledby="gallery-heading">
	<div class="th-container pb-10 md:pb-12">
		<SectionHeader
			eyebrow="OUR COMPANY"
			title="Inside Tiong Hock"
			description="A look inside our stores, operations, product range and technology across Matang and Kota Samarahan."
			headingId="gallery-heading"
			headingTag="h1"
		/>
	</div>

	<div class="th-container pb-16 md:pb-24">
		<ul class="gallery-grid" data-gallery-grid>
			{
				galleryPhotos.map((photo, index) => (
					<li
						class="gallery-grid__item gallery-grid__item--reveal"
						data-gallery-reveal
						style={`--reveal-index: ${index}`}
					>
						<button
							type="button"
							class="gallery-card"
							data-gallery-open
							data-index={index}
							aria-label={`Open image: ${photo.title ?? photo.alt}`}
						>
							<div class="gallery-card__frame">
								<img
									src={photo.src}
									alt={photo.alt}
									class="gallery-card__img gallery-card__img--decode"
									width={800}
									height={600}
									loading={index === 0 ? "eager" : "lazy"}
									decoding="async"
									fetchpriority={index === 0 ? "high" : undefined}
								/>
								{photo.title ? (
									<span class="gallery-card__title">{photo.title}</span>
								) : null}
							</div>
						</button>
					</li>
				))
			}
		</ul>
	</div>

	<div
		class="gallery-lightbox"
		data-gallery-lightbox
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Gallery image preview"
	>
		<div class="gallery-lightbox__backdrop" data-gallery-backdrop></div>
		<div class="gallery-lightbox__panel">
			<button type="button" class="gallery-lightbox__close" data-gallery-close aria-label="Close gallery preview">
				<span aria-hidden="true">×</span>
			</button>
			<button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-gallery-prev aria-label="Previous image">
				<span aria-hidden="true">‹</span>
			</button>
			<button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--next" data-gallery-next aria-label="Next image">
				<span aria-hidden="true">›</span>
			</button>
			<figure class="gallery-lightbox__figure">
				<div class="gallery-lightbox__stage" data-gallery-lightbox-stage>
					<img class="gallery-lightbox__img" data-gallery-lightbox-img alt="" />
					<img
						class="gallery-lightbox__img is-layer-idle"
						data-gallery-lightbox-img
						alt=""
						aria-hidden="true"
					/>
				</div>
				<figcaption class="gallery-lightbox__caption" data-gallery-lightbox-caption hidden></figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 768px) {
		.gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.35rem;
		}
	}

	@media (min-width: 1024px) {
		.gallery-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}

	.gallery-grid__item {
		min-width: 0;
	}

	.gallery-grid__item--reveal {
		opacity: 0;
		transform: translateY(18px) scale(0.985);
		transition:
			opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--reveal-index, 0) * 60ms);
		will-change: opacity, transform;
	}

	.gallery-grid__item--reveal.is-revealed {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.gallery-card {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		text-align: left;
		border-radius: 0.75rem;
	}

	.gallery-card:focus-visible {
		outline: 2px solid var(--color-brand-lime);
		outline-offset: 3px;
	}

	.gallery-card__frame {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0.75rem;
		border: 1px solid rgb(226 232 240);
		background: rgb(241 245 249);
		box-shadow: 0 4px 14px rgb(15 23 42 / 0.06);
		transition:
			box-shadow 0.25s ease,
			border-color 0.25s ease;
	}

	.gallery-card:hover .gallery-card__frame,
	.gallery-card:focus-visible .gallery-card__frame {
		border-color: rgb(203 213 225);
		box-shadow: 0 10px 28px rgb(15 23 42 / 0.1);
	}

	.gallery-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.35s ease;
	}

	.gallery-card__img--decode {
		opacity: 0;
		transition:
			opacity 400ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.35s ease;
	}

	.gallery-card__img--decode.is-ready {
		opacity: 1;
	}

	.gallery-card:hover .gallery-card__img,
	.gallery-card:focus-visible .gallery-card__img {
		transform: scale(1.04);
	}

	.gallery-card__title {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 2rem 0.85rem 0.75rem;
		background: linear-gradient(to top, rgb(0 56 32 / 0.82), transparent);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.gallery-lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.gallery-lightbox[hidden] {
		display: none !important;
	}

	.gallery-lightbox__backdrop {
		position: absolute;
		inset: 0;
		background: rgb(15 23 42 / 0.88);
		opacity: 0;
		transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-lightbox.is-open .gallery-lightbox__backdrop {
		opacity: 1;
	}

	.gallery-lightbox__panel {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(100%, 56rem);
		max-height: min(92dvh, 900px);
	}

	.gallery-lightbox__figure {
		margin: 0;
		width: 100%;
		max-height: min(92dvh, 900px);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		opacity: 0;
		transform: translateY(8px) scale(0.96);
		transition:
			opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-lightbox.is-open .gallery-lightbox__figure {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.gallery-lightbox__stage {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		max-height: min(82dvh, 780px);
	}

	.gallery-lightbox__stage .gallery-lightbox__img {
		grid-area: 1 / 1;
		max-width: 100%;
		max-height: min(82dvh, 780px);
		width: auto;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: contain;
		border-radius: 0.5rem;
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
		opacity: 1;
		transform: translateX(0);
	}

	.gallery-lightbox__stage.is-nav-animating .gallery-lightbox__img {
		transition:
			opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-lightbox__img.is-layer-idle:not(.is-nav-animating-layer) {
		visibility: hidden;
		pointer-events: none;
	}

	.gallery-lightbox__img.nav-enter-from-next {
		opacity: 0;
		transform: translateX(24px);
	}

	.gallery-lightbox__img.nav-enter-from-prev {
		opacity: 0;
		transform: translateX(-24px);
	}

	.gallery-lightbox__img.nav-exit-to-next {
		opacity: 0;
		transform: translateX(-24px);
	}

	.gallery-lightbox__img.nav-exit-to-prev {
		opacity: 0;
		transform: translateX(24px);
	}

	.gallery-lightbox__img.nav-enter-to {
		opacity: 1;
		transform: translateX(0);
	}

	.gallery-lightbox__caption {
		margin: 0;
		max-width: 36rem;
		text-align: center;
		font-size: 0.875rem;
		color: rgb(226 232 240);
	}

	.gallery-lightbox__close {
		position: absolute;
		top: -0.25rem;
		right: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 999px;
		background: rgb(15 23 42 / 0.6);
		color: #fff;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-lightbox.is-open .gallery-lightbox__close {
		opacity: 1;
	}

	.gallery-lightbox__close:hover {
		background: rgb(15 23 42 / 0.85);
	}

	.gallery-lightbox__nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-top: -1.375rem;
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 999px;
		background: rgb(15 23 42 / 0.55);
		color: #fff;
		font-size: 1.75rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-lightbox.is-open .gallery-lightbox__nav {
		opacity: 1;
	}

	.gallery-lightbox__nav:hover {
		background: rgb(15 23 42 / 0.85);
	}

	.gallery-lightbox__nav--prev {
		left: -0.25rem;
	}

	.gallery-lightbox__nav--next {
		right: -0.25rem;
	}

	.gallery-lightbox__close:focus-visible,
	.gallery-lightbox__nav:focus-visible {
		outline: 2px solid var(--color-brand-lime);
		outline-offset: 2px;
	}

	@media (max-width: 640px) {
		.gallery-lightbox__nav--prev {
			left: 0.25rem;
		}

		.gallery-lightbox__nav--next {
			right: 0.25rem;
		}

		.gallery-lightbox__close {
			top: 0.25rem;
			right: 0.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-grid__item--reveal {
			opacity: 1;
			transform: none;
			transition: none;
			will-change: auto;
		}

		.gallery-card__img,
		.gallery-card__img--decode,
		.gallery-card__frame {
			transition: none;
		}

		.gallery-card__img--decode {
			opacity: 1;
		}

		.gallery-card:hover .gallery-card__img,
		.gallery-card:focus-visible .gallery-card__img {
			transform: none;
		}

		.gallery-lightbox__backdrop,
		.gallery-lightbox__figure,
		.gallery-lightbox__close,
		.gallery-lightbox__nav {
			transition: none;
		}

		.gallery-lightbox:not([hidden]) .gallery-lightbox__backdrop,
		.gallery-lightbox:not([hidden]) .gallery-lightbox__figure,
		.gallery-lightbox:not([hidden]) .gallery-lightbox__close,
		.gallery-lightbox:not([hidden]) .gallery-lightbox__nav {
			opacity: 1;
			transform: none;
		}

		.gallery-lightbox__stage.is-nav-animating .gallery-lightbox__img {
			transition: none;
		}
	}
</style>

<script define:vars={{ photos: galleryPhotos }}>
	function whenImageReady(img) {
		if (img.complete && img.naturalWidth > 0) {
			return Promise.resolve();
		}
		if (typeof img.decode === "function") {
			return img.decode().catch(() => {});
		}
		return new Promise((resolve) => {
			img.addEventListener("load", () => resolve(), { once: true });
			img.addEventListener("error", () => resolve(), { once: true });
		});
	}

	function markImageReady(img) {
		whenImageReady(img).then(() => {
			requestAnimationFrame(() => img.classList.add("is-ready"));
		});
	}

	function initGalleryReveal() {
		const grid = document.querySelector("[data-gallery-grid]");
		if (!grid) return;

		const items = grid.querySelectorAll("[data-gallery-reveal]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		items.forEach((item) => {
			const img = item.querySelector(".gallery-card__img--decode");
			if (!img) return;
			if (reducedMotion) {
				img.classList.add("is-ready");
			} else {
				markImageReady(img);
			}
		});

		if (reducedMotion) {
			items.forEach((item) => item.classList.add("is-revealed"));
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const item = entry.target;
					observer.unobserve(item);
					requestAnimationFrame(() => item.classList.add("is-revealed"));
				}
			},
			{ root: null, rootMargin: "0px 0px -5% 0px", threshold: 0 },
		);

		items.forEach((item) => observer.observe(item));
	}

	function initGalleryLightbox() {
		const grid = document.querySelector("[data-gallery-grid]");
		const lightbox = document.querySelector("[data-gallery-lightbox]");
		if (!grid || !lightbox) return;

		const imgLayers = Array.from(lightbox.querySelectorAll("[data-gallery-lightbox-img]"));
		const stageEl = lightbox.querySelector("[data-gallery-lightbox-stage]");
		const captionEl = lightbox.querySelector("[data-gallery-lightbox-caption]");
		const closeBtn = lightbox.querySelector("[data-gallery-close]");
		const prevBtn = lightbox.querySelector("[data-gallery-prev]");
		const nextBtn = lightbox.querySelector("[data-gallery-next]");
		const backdrop = lightbox.querySelector("[data-gallery-backdrop]");
		const figureEl = lightbox.querySelector(".gallery-lightbox__figure");
		const triggers = grid.querySelectorAll("[data-gallery-open]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const LIGHTBOX_CLOSE_MS = 300;
		const LIGHTBOX_NAV_MS = 280;

		let index = 0;
		let lastFocus = null;
		let isClosing = false;
		let isNavigating = false;
		let activeLayer = 0;

		const NAV_CLASSES = [
			"nav-enter-from-next",
			"nav-enter-from-prev",
			"nav-exit-to-next",
			"nav-exit-to-prev",
			"nav-enter-to",
			"is-nav-animating-layer",
		];

		function activeImg() {
			return imgLayers[activeLayer] ?? null;
		}

		function inactiveImg() {
			return imgLayers[activeLayer ^ 1] ?? null;
		}

		function clearNavClasses(img) {
			if (!img) return;
			for (const cls of NAV_CLASSES) img.classList.remove(cls);
		}

		function resetImgLayers() {
			activeLayer = 0;
			isNavigating = false;
			stageEl?.classList.remove("is-nav-animating");
			for (let i = 0; i < imgLayers.length; i++) {
				const img = imgLayers[i];
				clearNavClasses(img);
				if (i === 0) {
					img.classList.remove("is-layer-idle");
					img.removeAttribute("aria-hidden");
				} else {
					img.classList.add("is-layer-idle");
					img.setAttribute("aria-hidden", "true");
					img.removeAttribute("src");
					img.alt = "";
				}
			}
		}

		function setCaption(photo) {
			if (!captionEl) return;
			if (photo.title) {
				captionEl.textContent = photo.title;
				captionEl.hidden = false;
			} else {
				captionEl.textContent = "";
				captionEl.hidden = true;
			}
		}

		function showAt(i) {
			const total = photos.length;
			if (total === 0) return;
			index = (i + total) % total;
			const photo = photos[index];
			const img = activeImg();
			if (!img) return;
			img.src = photo.src;
			img.alt = photo.alt;
			setCaption(photo);
		}

		function preloadOnImg(img, photo) {
			return new Promise((resolve) => {
				if (!img || !photo) {
					resolve();
					return;
				}
				const done = () => whenImageReady(img).then(resolve);
				if (img.getAttribute("src") === photo.src) {
					done();
					return;
				}
				img.src = photo.src;
				img.alt = photo.alt;
				done();
			});
		}

		function finishNavTransition(nextIndex) {
			const incoming = inactiveImg();
			const outgoing = activeImg();
			activeLayer ^= 1;
			isNavigating = false;
			stageEl?.classList.remove("is-nav-animating");
			clearNavClasses(outgoing);
			clearNavClasses(incoming);
			if (outgoing) {
				outgoing.classList.add("is-layer-idle");
				outgoing.setAttribute("aria-hidden", "true");
				outgoing.removeAttribute("src");
				outgoing.alt = "";
			}
			if (incoming) {
				incoming.classList.remove("is-layer-idle");
				incoming.removeAttribute("aria-hidden");
			}
			index = nextIndex;
			setCaption(photos[index]);
		}

		function navigateBy(delta) {
			if (isClosing || isNavigating) return;
			const total = photos.length;
			if (total === 0) return;
			const nextIndex = (index + delta + total) % total;
			if (nextIndex === index) return;

			if (reducedMotion || lightbox.hidden) {
				showAt(nextIndex);
				return;
			}

			const direction = delta > 0 ? "next" : "prev";
			const photo = photos[nextIndex];
			const outgoing = activeImg();
			const incoming = inactiveImg();
			if (!outgoing || !incoming || !stageEl) {
				showAt(nextIndex);
				return;
			}

			isNavigating = true;
			preloadOnImg(incoming, photo).then(() => {
				if (!isNavigating || lightbox.hidden) {
					isNavigating = false;
					return;
				}

				incoming.classList.remove("is-layer-idle");
				incoming.setAttribute("aria-hidden", "false");
				clearNavClasses(outgoing);
				clearNavClasses(incoming);

				const enterFrom = direction === "next" ? "nav-enter-from-next" : "nav-enter-from-prev";
				const exitTo = direction === "next" ? "nav-exit-to-next" : "nav-exit-to-prev";

				incoming.classList.add(enterFrom, "is-nav-animating-layer");
				stageEl.classList.add("is-nav-animating");
				setCaption(photo);

				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						outgoing.classList.add(exitTo, "is-nav-animating-layer");
						incoming.classList.remove(enterFrom);
						incoming.classList.add("nav-enter-to");
					});
				});

				let finished = false;
				const complete = () => {
					if (finished) return;
					finished = true;
					incoming.removeEventListener("transitionend", onTransitionEnd);
					window.clearTimeout(fallbackTimer);
					finishNavTransition(nextIndex);
				};
				const onTransitionEnd = (event) => {
					if (event.target !== incoming || event.propertyName !== "transform") return;
					complete();
				};

				incoming.addEventListener("transitionend", onTransitionEnd);
				const fallbackTimer = window.setTimeout(complete, LIGHTBOX_NAV_MS);
			});
		}

		function finishClose() {
			isClosing = false;
			isNavigating = false;
			lightbox.hidden = true;
			lightbox.classList.remove("is-open");
			document.body.style.overflow = "";
			resetImgLayers();
			for (const img of imgLayers) {
				img.removeAttribute("src");
				img.alt = "";
			}
			if (captionEl) {
				captionEl.textContent = "";
				captionEl.hidden = true;
			}
			if (lastFocus instanceof HTMLElement) lastFocus.focus();
		}

		function openAt(i, trigger) {
			if (isClosing || isNavigating) return;
			lastFocus = trigger;
			resetImgLayers();
			showAt(i);
			lightbox.classList.remove("is-open");
			lightbox.hidden = false;
			document.body.style.overflow = "hidden";

			if (reducedMotion) {
				lightbox.classList.add("is-open");
				closeBtn?.focus();
				return;
			}

			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					lightbox.classList.add("is-open");
					closeBtn?.focus();
				});
			});
		}

		function close() {
			if (lightbox.hidden || isClosing) return;

			if (reducedMotion) {
				finishClose();
				return;
			}

			isClosing = true;
			lightbox.classList.remove("is-open");

			if (!figureEl) {
				window.setTimeout(finishClose, LIGHTBOX_CLOSE_MS);
				return;
			}

			let closed = false;
			const completeClose = () => {
				if (closed) return;
				closed = true;
				figureEl.removeEventListener("transitionend", onTransitionEnd);
				window.clearTimeout(fallbackTimer);
				finishClose();
			};
			const onTransitionEnd = (event) => {
				if (event.target !== figureEl || event.propertyName !== "transform") return;
				completeClose();
			};

			figureEl.addEventListener("transitionend", onTransitionEnd);
			const fallbackTimer = window.setTimeout(completeClose, LIGHTBOX_CLOSE_MS);
		}

		triggers.forEach((btn) => {
			btn.addEventListener("click", () => {
				if (isClosing) return;
				const i = Number(btn.getAttribute("data-index"));
				openAt(i, btn);
			});
		});

		closeBtn?.addEventListener("click", close);
		backdrop?.addEventListener("click", close);
		prevBtn?.addEventListener("click", () => navigateBy(-1));
		nextBtn?.addEventListener("click", () => navigateBy(1));

		lightbox.addEventListener("keydown", (event) => {
			if (lightbox.hidden || isClosing) return;
			if (event.key === "Escape") {
				event.preventDefault();
				close();
			} else if (event.key === "ArrowLeft") {
				event.preventDefault();
				navigateBy(-1);
			} else if (event.key === "ArrowRight") {
				event.preventDefault();
				navigateBy(1);
			}
		});
	}

	initGalleryReveal();
	initGalleryLightbox();
</script>
