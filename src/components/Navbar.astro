---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
 { href: "/", label: "Home" },
	{ href: "/parts", label: "Parts" },
	{ href: "/about", label: "About" },
	{ href: "/directors", label: "Directors" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/careers", label: "Careers" },
	{ href: "/contact", label: "Contact" },
];

function isActive(href: string) {
	const normalised = href.replace(/\/$/, "") || "/";
	return currentPath === normalised;
}

const linkClass = (href: string) =>
	[
		"px-2.5 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] transition sm:px-3 sm:text-xs sm:tracking-[0.18em]",
		isActive(href) ? "text-brand" : "text-slate-600 hover:text-brand",
	].join(" ");

const mobileLinkClass = (href: string) =>
	[
		"block rounded-lg px-3 py-3 text-sm font-semibold uppercase tracking-[0.12em] transition",
		isActive(href)
			? "bg-[color-mix(in_oklab,var(--color-brand-lime)_18%,white)] text-brand"
			: "text-slate-700 hover:bg-slate-50",
	].join(" ");
---

<header
	class="site-header sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-md supports-[backdrop-filter]:bg-white/80"
>
	<div class="th-container flex min-h-[5rem] items-center justify-between gap-3 sm:min-h-[5.5rem] lg:min-h-[6.25rem]">
		<a
			href="/"
			class="group flex min-w-0 shrink-0 items-center outline-offset-4 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
		>
			<img
				src="/logo-horizontal.png"
				width="420"
				height="96"
				alt="Tiong Hock Auto Parts"
				class="h-14 w-auto max-h-14 object-contain object-left transition duration-300 ease-out group-hover:opacity-90 sm:h-16 sm:max-h-16 lg:h-[4.5rem] lg:max-h-[4.5rem]"
				loading="eager"
				decoding="async"
			/>
		</a>

		<nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
			{
				links.map(({ href, label }) => (
					<a href={href} class={linkClass(href)} aria-current={isActive(href) ? "page" : undefined}>
						{label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:border-slate-300 lg:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
			data-mobile-menu-toggle
		>
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t border-slate-200 bg-white lg:hidden"
		aria-label="Mobile"
		data-mobile-menu
	>
		<div class="th-container grid gap-1 py-3">
			{
				links.map(({ href, label }) => (
					<a href={href} class={mobileLinkClass(href)} aria-current={isActive(href) ? "page" : undefined}>
						{label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			menu.classList.toggle("hidden", !open);
		};

		document.addEventListener("keydown", (event) => { if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { setOpen(false); toggle.focus(); } });
toggle.addEventListener("click", () => {
			setOpen(menu.classList.contains("hidden"));
		});

		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		window.addEventListener("resize", () => {
			if (window.matchMedia("(min-width: 1024px)").matches) setOpen(false);
		});
	}
</script>

