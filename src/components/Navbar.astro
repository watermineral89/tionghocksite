---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
	{ href: "/search", label: "Search" },
	{ href: "/parts", label: "Parts" },
	{ href: "/about", label: "About" },
	{ href: "/directors", label: "Directors" },
	{ href: "/capabilities", label: "Capabilities" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/contact", label: "Contact" },
];

function isActive(href: string) {
	const normalised = href.replace(/\/$/, "") || "/";
	return currentPath === normalised;
}

const linkClass = (href: string) =>
	[
		"px-2.5 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] transition sm:px-3 sm:text-xs sm:tracking-[0.18em]",
		isActive(href) ? "text-brand-green" : "text-slate-600 hover:text-slate-900",
	].join(" ");

const mobileLinkClass = (href: string) =>
	[
		"block rounded-lg px-3 py-3 text-sm font-semibold uppercase tracking-[0.12em] transition",
		isActive(href) ? "bg-emerald-50 text-brand-green" : "text-slate-700 hover:bg-slate-50",
	].join(" ");
---

<header
	class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-md supports-[backdrop-filter]:bg-white/80"
>
	<div class="th-container flex min-h-[4.25rem] items-center justify-between gap-3 lg:min-h-[5rem]">
		<a
			href="/"
			class="group flex min-w-0 shrink-0 items-center border border-slate-200 bg-white p-1 outline-offset-4 transition hover:border-slate-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-green sm:p-1.5"
		>
			<img
				src="/image_1.png"
				width="240"
				height="64"
				alt="Tiong Hock Auto Parts (Kch) Sdn Bhd"
				class="h-11 w-auto max-h-12 object-contain object-left transition-[filter] duration-300 ease-out group-hover:opacity-90 sm:h-12 sm:max-h-14 lg:h-14 lg:max-h-14"
				loading="eager"
				decoding="async"
			/>
		</a>

		<nav class="hidden items-center gap-0.5 md:flex" aria-label="Primary">
			{
				links.map(({ href, label }) => (
					<a href={href} class={linkClass(href)} aria-current={isActive(href) ? "page" : undefined}>
						{label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href="tel:+6082649433"
				class="hidden font-mono text-[0.65rem] font-medium uppercase tracking-[0.14em] text-slate-500 transition hover:text-slate-900 sm:text-xs lg:inline"
			>
				082-649433
			</a>
			<a
				href="/contact"
				class:list={[
					"hidden items-center justify-center px-3 py-2 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:inline-flex sm:px-4",
					isActive("/contact")
						? "bg-brand-green text-white focus-visible:outline-brand-green"
						: "bg-brand text-white hover:bg-[color-mix(in_oklab,var(--color-brand)_88%,black)] focus-visible:outline-brand",
				]}
				aria-current={isActive("/contact") ? "page" : undefined}
			>
				Contact
			</a>

			<button
				type="button"
				class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:border-slate-300 md:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-mobile-menu-toggle
			>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t border-slate-200 bg-white md:hidden"
		aria-label="Mobile"
		data-mobile-menu
	>
		<div class="th-container grid gap-1 py-3">
			{
				links.map(({ href, label }) => (
					<a href={href} class={mobileLinkClass(href)} aria-current={isActive(href) ? "page" : undefined}>
						{label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			menu.classList.toggle("hidden", !open);
		};

		toggle.addEventListener("click", () => {
			setOpen(menu.classList.contains("hidden"));
		});

		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		window.addEventListener("resize", () => {
			if (window.matchMedia("(min-width: 768px)").matches) setOpen(false);
		});
	}
</script>
