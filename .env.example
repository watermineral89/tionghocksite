# Copy this file to `.env` in the project root on the Matang server.
# Never commit `.env` — it is gitignored.

# SQL Server (AutoCount / AED database)
DB_SERVER=localhost
# Examples: localhost  |  .\SQLEXPRESS  |  192.168.1.10
DB_DATABASE=AED_AED

# Option 1 — SQL login (recommended: create a READ-ONLY user)
DB_USERNAME=catalog_readonly
DB_PASSWORD=change-me

# Option 2 — Windows auth instead of username/password
# DB_TRUSTED_CONNECTION=true

# Optional ODBC driver name (default is fine on most Matang servers)
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# After export, auto git commit + push so Vercel redeploys (set to 1 on Matang)
CATALOG_AUTO_PUSH=0
