{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"framework": "astro",
	"functions": {
		"api/**/*.js": {
			"memory": 1024,
			"maxDuration": 30
		}
	},
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		}
	]
}
